{{ 'namu-tokens.css' | asset_url | stylesheet_tag }}
{{ 'namu-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blog_handle = section.settings.blog | default: 'news'
  assign post_limit  = section.settings.posts_to_show | default: 3
  assign blog_obj    = blogs[blog_handle]
-%}

<section class="namu-blog" aria-label="{{ section.settings.title | default: 'Blog' | escape }}">
  <div class="namu-blog__inner">

    {%- comment -%} ── Header ─────────────────────────────── {%- endcomment -%}
    <div class="namu-blog__header">
      {%- if section.settings.pill_label != blank -%}
        <a
          href="{{ blog_obj.url | default: '/blogs/news' }}"
          class="namu-blog__pill"
          aria-label="{{ section.settings.pill_label | escape }}"
        >
          {{ section.settings.pill_label | upcase | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="namu-blog__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="namu-blog__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} ── Grid ───────────────────────────────── {%- endcomment -%}
    <div class="namu-blog__grid">
      {%- if blog_obj and blog_obj.articles_count > 0 -%}
        {%- for article in blog_obj.articles limit: post_limit -%}
          <article class="namu-blog__card">
            <a href="{{ article.url }}" class="namu-blog__card-link" aria-label="{{ article.title | escape }}">

              {%- comment -%} Image {%- endcomment -%}
              <div class="namu-blog__card-media">
                {%- if article.image != blank -%}
                  <img
                    src="{{ article.image | image_url: width: 800 }}"
                    srcset="
                      {{ article.image | image_url: width: 400 }} 400w,
                      {{ article.image | image_url: width: 700 }} 700w,
                      {{ article.image | image_url: width: 1000 }} 1000w"
                    sizes="(max-width: 767px) 100vw, 33vw"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="lazy"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                    class="namu-blog__card-img"
                  >
                {%- else -%}
                  <div class="namu-blog__card-img-placeholder" aria-hidden="true">
                    <svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect width="80" height="60" fill="#e8ede9"/>
                      <path d="M40 12 C40 2 26 2 26 12 S26 28 40 28 C40 14 54 12 54 12 S54 28 40 28 Z" fill="none" stroke="#045133" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      <line x1="40" y1="28" x2="40" y2="46" stroke="#045133" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>

              {%- comment -%} Content {%- endcomment -%}
              <div class="namu-blog__card-body">
                {%- if article.tags.size > 0 -%}
                  <span class="namu-blog__card-tag">{{ article.tags | first | escape }}</span>
                {%- endif -%}
                <h3 class="namu-blog__card-title">{{ article.title | escape }}</h3>
                {%- if article.excerpt != blank -%}
                  <p class="namu-blog__card-excerpt">{{ article.excerpt | strip_html | truncate: 100 }}</p>
                {%- elsif article.content != blank -%}
                  <p class="namu-blog__card-excerpt">{{ article.content | strip_html | truncate: 100 }}</p>
                {%- endif -%}
                <span class="namu-blog__card-cta" aria-hidden="true">
                  {{ section.settings.cta_label | default: 'Ler mais' | escape }}
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="1" y1="5" x2="13" y2="5"/>
                    <polyline points="9 1 13 5 9 9"/>
                  </svg>
                </span>
              </div>

            </a>
          </article>
        {%- endfor -%}

      {%- else -%}
        {%- comment -%} Fallback: static demo cards from schema blocks {%- endcomment -%}
        {%- for block in section.blocks -%}
          <article class="namu-blog__card" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="namu-blog__card-link" aria-label="{{ block.settings.title | escape }}">

              <div class="namu-blog__card-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 400 }} 400w,
                      {{ block.settings.image | image_url: width: 700 }} 700w,
                      {{ block.settings.image | image_url: width: 1000 }} 1000w"
                    sizes="(max-width: 767px) 100vw, 33vw"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    class="namu-blog__card-img"
                  >
                {%- else -%}
                  <div class="namu-blog__card-img-placeholder" aria-hidden="true">
                    <svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect width="80" height="60" fill="#e8ede9"/>
                      <path d="M40 12 C40 2 26 2 26 12 S26 28 40 28 C40 14 54 12 54 12 S54 28 40 28 Z" fill="none" stroke="#045133" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      <line x1="40" y1="28" x2="40" y2="46" stroke="#045133" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>

              <div class="namu-blog__card-body">
                {%- if block.settings.tag != blank -%}
                  <span class="namu-blog__card-tag">{{ block.settings.tag | escape }}</span>
                {%- endif -%}
                <h3 class="namu-blog__card-title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.excerpt != blank -%}
                  <p class="namu-blog__card-excerpt">{{ block.settings.excerpt | escape }}</p>
                {%- endif -%}
                <span class="namu-blog__card-cta" aria-hidden="true">
                  {{ section.settings.cta_label | default: 'Ler mais' | escape }}
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="1" y1="5" x2="13" y2="5"/>
                    <polyline points="9 1 13 5 9 9"/>
                  </svg>
                </span>
              </div>

            </a>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_global_label != blank -%}
      <div class="namu-blog__cta-wrap">
        <a href="{{ section.settings.cta_global_link | default: '/blogs/news' }}" class="namu-blog__cta-global">
          {{ section.settings.cta_global_label | escape }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Blog Editorial",
  "tag": "section",
  "class": "shopify-section-namu-blog",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Número de artigos",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "pill_label",
      "label": "Rótulo do botão pill",
      "default": "Matcha Blog"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título da seção (opcional)"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo (opcional)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto do CTA do card",
      "default": "LER MAIS"
    },
    {
      "type": "text",
      "id": "cta_global_label",
      "label": "Texto do botão global (abaixo do grid)",
      "default": "CONFIRA TODOS OS NOSSOS CONTEÚDOS"
    },
    {
      "type": "url",
      "id": "cta_global_link",
      "label": "Link do botão global",
      "default": "/blogs/news"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Artigo (fallback)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag / categoria"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Artigo"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Trecho / descrição curta"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link do artigo"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Blog Editorial",
      "settings": {
        "pill_label": "Matcha Blog",
        "cta_label": "Ler mais"
      },
      "blocks": [
        {
          "type": "article",
          "settings": {
            "tag": "Guia",
            "title": "O que é matcha?",
            "excerpt": "Descubra a origem, o cultivo e os segredos por trás da folha de chá mais celebrada do mundo."
          }
        },
        {
          "type": "article",
          "settings": {
            "tag": "Guia",
            "title": "Guia definitivo do matcha perfeito",
            "excerpt": "Da temperatura da água à técnica de chasen: tudo o que você precisa para preparar o matcha ideal em casa."
          }
        },
        {
          "type": "article",
          "settings": {
            "tag": "Saúde",
            "title": "7 benefícios comprovados do matcha",
            "excerpt": "Energia limpa, antioxidantes e foco sem ansiedade. Veja o que a ciência diz sobre o poder do matcha."
          }
        }
      ]
    }
  ]
}
{% endschema %}
