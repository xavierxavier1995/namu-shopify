{% render 'css-defer', file: 'namu-b2b.css' %}

<section class="namu-b2b" aria-label="{{ section.settings.title | default: 'Para o seu negócio' | escape }}">
  <a href="{{ section.settings.cta_link | default: '/pages/para-seu-negocio' }}" class="namu-b2b__link">
    <div class="namu-b2b__bg">
      {%- if section.settings.image != blank -%}
        {%- assign img = section.settings.image -%}
        <img
          src="{{ img | image_url: width: 1600 }}"
          srcset="{{ img | image_url: width: 800 }} 800w,
                  {{ img | image_url: width: 1200 }} 1200w,
                  {{ img | image_url: width: 1600 }} 1600w"
          sizes="100vw"
          alt="{{ img.alt | default: section.settings.title | escape }}"
          loading="lazy"
          width="{{ img.width }}"
          height="{{ img.height }}"
          class="namu-b2b__bg-img"
        >
      {%- else -%}
        <img
          src="{{ section.settings.fallback_asset | default: 'NAMU-banner_para-o-seu-negocio_desktop.jpg' | asset_url }}"
          alt="{{ section.settings.title | escape }}"
          loading="lazy"
          decoding="async"
          class="namu-b2b__bg-img"
        >
      {%- endif -%}
      <div class="namu-b2b__overlay"></div>
    </div>

    <div class="namu-b2b__content">
      {%- if section.settings.title != blank -%}
        <h2 class="namu-b2b__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="namu-b2b__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      <div class="namu-b2b__categories">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category_pill' and block.settings.label != blank -%}
            <span class="namu-b2b__pill" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </a>
</section>

{% schema %}
{
  "name": "Seção B2B",
  "tag": "section",
  "class": "shopify-section-namu-b2b",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "PARA O SEU NEGÓCIO"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Seu negócio merece um matcha à altura. Nossas soluções para empresas são versáteis e vão muito além da venda."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link da seção"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem de fundo (Shopify CDN)"
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Asset local (fallback)",
      "default": "NAMU-banner_para-o-seu-negocio_desktop.jpg"
    }
  ],
  "blocks": [
    {
      "type": "category_pill",
      "name": "Categoria",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "Categoria"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Seção B2B",
      "settings": {
        "title": "PARA O SEU NEGÓCIO",
        "subtitle": "Seu negócio merece um matcha à altura. Nossas soluções para empresas são versáteis e vão muito além da venda."
      },
      "blocks": [
        { "type": "category_pill", "settings": { "label": "INDÚSTRIA" } },
        { "type": "category_pill", "settings": { "label": "FOOD SERVICE" } },
        { "type": "category_pill", "settings": { "label": "CORPORATIVO" } },
        { "type": "category_pill", "settings": { "label": "CONSULTORIA" } }
      ]
    }
  ]
}
{% endschema %}
