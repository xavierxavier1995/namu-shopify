{% render 'css-defer', file: 'namu-collection.css' %}

{%- paginate collection.products by 48 -%}

<section class="namu-coll" aria-label="{{ collection.title | escape }}">

  <div class="namu-coll__hero">
    <div class="namu-coll__hero-overlay"></div>
    <div class="namu-coll__hero-inner">
      <h1 class="namu-coll__hero-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="namu-coll__hero-desc">{{ collection.description | strip_html | truncate: 200 }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="namu-coll__benefits">
    <div class="namu-coll__benefits-inner">
      <span class="namu-coll__benefit">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8 7 12 13 4"/></svg>
        Matcha direto de Hadong
      </span>
      <span class="namu-coll__benefit">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8 7 12 13 4"/></svg>
        Processo 100% rastreável
      </span>
      <span class="namu-coll__benefit">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8 7 12 13 4"/></svg>
        +5.000 clientes satisfeitos
      </span>
      <span class="namu-coll__benefit">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8 7 12 13 4"/></svg>
        100% orgânico
      </span>
      <span class="namu-coll__benefit">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8 7 12 13 4"/></svg>
        Energia limpa + foco
      </span>
      <span class="namu-coll__benefit">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8 7 12 13 4"/></svg>
        Aprovado por baristas
      </span>
    </div>
  </div>

  <div class="namu-coll__body">
    <aside class="namu-coll__sidebar" aria-label="Filtros">
      <button class="namu-coll__filter-toggle" aria-expanded="false" aria-controls="namu-coll-filters">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="14" y2="12"/><line x1="4" y1="18" x2="9" y2="18"/></svg>
        Filtrar
      </button>
      <div class="namu-coll__filters" id="namu-coll-filters">
        {%- for filter in collection.filters -%}
          <details class="namu-coll__filter-group" {% if forloop.index <= 3 %}open{% endif %}>
            <summary class="namu-coll__filter-heading">
              {{ filter.label }}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 1 5 5 9 1"/></svg>
            </summary>
            <div class="namu-coll__filter-options">
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  <div class="namu-coll__price-range">
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}" placeholder="Min" class="namu-coll__price-input" aria-label="Preço mínimo">
                    <span class="namu-coll__price-sep">—</span>
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}" placeholder="Max" class="namu-coll__price-input" aria-label="Preço máximo">
                  </div>
                {%- else -%}
                  {%- for value in filter.values -%}
                    <label class="namu-coll__filter-label">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} class="namu-coll__filter-check">
                      <span class="namu-coll__filter-text">{{ value.label }}</span>
                      <span class="namu-coll__filter-count">({{ value.count }})</span>
                    </label>
                  {%- endfor -%}
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </aside>

    <main class="namu-coll__grid-wrap">
      <div class="namu-coll__toolbar">
        <p class="namu-coll__count">{{ collection.products_count }} produtos</p>
        <div class="namu-coll__sort">
          <label for="namu-sort" class="namu-coll__sort-label">Ordenar:</label>
          <select id="namu-sort" class="namu-coll__sort-select" onchange="window.location.href=this.value">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.url }}" {% if collection.sort_by == option.value %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>

      <div class="namu-coll__grid">
        {%- for product in collection.products -%}
          <a href="{{ product.url }}" class="namu-coll__card" aria-label="{{ product.title | escape }}">
            <div class="namu-coll__card-media">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
                  sizes="(max-width: 767px) 50vw, 33vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  class="namu-coll__card-img"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'namu-coll__card-placeholder' }}
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="namu-coll__badge-sale">OFERTA</span>
              {%- endif -%}
            </div>
            <div class="namu-coll__card-info">
              {%- if product.type != blank -%}
                <span class="namu-coll__card-type">{{ product.type }}</span>
              {%- endif -%}
              <h3 class="namu-coll__card-title">{{ product.title }}</h3>
              <div class="namu-coll__card-price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="namu-coll__price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
                <span class="namu-coll__price-current">{{ product.price | money }}</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="namu-coll__pagination" aria-label="Paginação">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    </main>
  </div>

</section>

<script>
(function(){
  const toggle = document.querySelector('.namu-coll__filter-toggle');
  const filters = document.querySelector('.namu-coll__filters');
  if (!toggle || !filters) return;
  toggle.addEventListener('click', function() {
    const expanded = this.getAttribute('aria-expanded') === 'true';
    this.setAttribute('aria-expanded', !expanded);
    filters.classList.toggle('namu-coll__filters--open');
  });
})();
</script>

{%- endpaginate -%}

{% schema %}
{
  "name": "Coleção Namu",
  "tag": "section",
  "class": "shopify-section-namu-collection",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagem de fundo do Hero"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Coleção Namu"
    }
  ]
}
{% endschema %}
