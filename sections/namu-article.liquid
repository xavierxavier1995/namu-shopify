{{ 'namu-tokens.css' | asset_url | stylesheet_tag }}
{{ 'namu-article.css' | asset_url | stylesheet_tag }}

{%- assign words = article.content | strip_html | split: ' ' | size -%}
{%- assign reading_time = words | divided_by: 200 -%}
{%- if reading_time < 1 -%}{%- assign reading_time = 1 -%}{%- endif -%}

<article class="namu-art" itemscope itemtype="https://schema.org/Article">
  <meta itemprop="author" content="{{ article.author }}">
  <meta itemprop="datePublished" content="{{ article.published_at | date: '%Y-%m-%d' }}">

  <header class="namu-art__header">
    <div class="namu-art__header-inner">
      <nav class="namu-art__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="{{ blog.url }}">Namu Journal</a>
        {%- if article.tags.size > 0 -%}
          <span aria-hidden="true">/</span>
          <a href="{{ blog.url }}/tagged/{{ article.tags.first | handleize }}">{{ article.tags.first }}</a>
        {%- endif -%}
      </nav>

      {%- if article.tags.size > 0 -%}
        <span class="namu-art__category">{{ article.tags.first | upcase }}</span>
      {%- endif -%}

      <h1 class="namu-art__title" itemprop="headline">{{ article.title }}</h1>

      <div class="namu-art__meta">
        <span class="namu-art__reading-time">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {{ reading_time }} min de leitura
        </span>
        <span class="namu-art__origin">
          <img src="{{ 'flag-south-korea.svg' | asset_url }}" alt="Coreia do Sul" width="18" height="12" class="namu-art__flag">
          Origem: Hadong, Coreia do Sul
        </span>
      </div>
    </div>
  </header>

  {%- if article.image != blank -%}
    <div class="namu-art__hero-image">
      <img
        src="{{ article.image | image_url: width: 1200 }}"
        srcset="{{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 900 }} 900w, {{ article.image | image_url: width: 1200 }} 1200w"
        sizes="(max-width: 767px) 100vw, 740px"
        alt="{{ article.image.alt | default: article.title | escape }}"
        loading="eager"
        class="namu-art__hero-img"
        itemprop="image"
      >
    </div>
  {%- endif -%}

  <div class="namu-art__body">
    <div class="namu-art__content" itemprop="articleBody">
      {{ article.content }}
    </div>
  </div>

  <footer class="namu-art__footer">
    <div class="namu-art__footer-inner">

      <div class="namu-art__share">
        <span class="namu-art__share-label">Compartilhar:</span>
        <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ shop.url }}{{ article.url | url_encode }}" target="_blank" rel="noopener noreferrer" class="namu-art__share-link" aria-label="Compartilhar no WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </a>
        <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url | url_encode }}&description={{ article.title | url_encode }}" target="_blank" rel="noopener noreferrer" class="namu-art__share-link" aria-label="Salvar no Pinterest">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12a4 4 0 0 1 8 0c0 4-3 6-3 6"/><line x1="12" y1="12" x2="12" y2="21"/><circle cx="12" cy="12" r="10"/></svg>
        </a>
      </div>

      {%- assign related = blog.articles | where: 'tags', article.tags.first -%}
      {%- if related.size > 1 -%}
        <div class="namu-art__related">
          <h2 class="namu-art__related-title">Artigos relacionados</h2>
          <div class="namu-art__related-grid">
            {%- assign count = 0 -%}
            {%- for related_article in blog.articles -%}
              {%- if related_article.id == article.id -%}{%- continue -%}{%- endif -%}
              {%- if related_article.tags contains article.tags.first -%}
                {%- if count >= 3 -%}{%- break -%}{%- endif -%}
                <a href="{{ related_article.url }}" class="namu-art__related-card">
                  {%- if related_article.image != blank -%}
                    <img
                      src="{{ related_article.image | image_url: width: 400 }}"
                      alt="{{ related_article.image.alt | default: related_article.title | escape }}"
                      loading="lazy"
                      class="namu-art__related-img"
                    >
                  {%- endif -%}
                  <h3 class="namu-art__related-card-title">{{ related_article.title }}</h3>
                </a>
                {%- assign count = count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="namu-art__cta-strip">
        <p class="namu-art__cta-text">Receba receitas exclusivas e novidades direto no seu e-mail.</p>
        <a href="/#namu-nl-form" class="namu-art__cta-btn">Assinar Newsletter</a>
      </div>

    </div>
  </footer>

</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "author": { "@type": "Organization", "name": {{ shop.name | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
  "datePublished": "{{ article.published_at | date: '%Y-%m-%d' }}",
  "image": "{{ article.image | image_url: width: 1200 }}"
}
</script>

{% schema %}
{
  "name": "Artigo Namu",
  "tag": "section",
  "class": "shopify-section-namu-article",
  "settings": [],
  "blocks": [],
  "presets": [
    {
      "name": "Artigo Namu"
    }
  ]
}
{% endschema %}
