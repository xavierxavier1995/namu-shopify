<section class="namu-coll-trust" aria-label="Benefícios">
  <div class="namu-coll-trust__inner">
    {%- for block in section.blocks -%}
      <span class="namu-coll-trust__item" {{ block.shopify_attributes }}>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 8 7 12 13 4"/></svg>
        {{ block.settings.text | escape }}
      </span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Trust Bar",
  "tag": "section",
  "class": "shopify-section-namu-collection-trust",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Benefício"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collection Trust Bar",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Matcha direto de Hadong" } },
        { "type": "benefit", "settings": { "text": "Processo 100% rastreável" } },
        { "type": "benefit", "settings": { "text": "+5.000 clientes satisfeitos" } },
        { "type": "benefit", "settings": { "text": "100% orgânico" } },
        { "type": "benefit", "settings": { "text": "Energia limpa + foco" } }
      ]
    }
  ]
}
{% endschema %}
