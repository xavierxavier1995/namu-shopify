{{ 'namu-tokens.css' | asset_url | stylesheet_tag }}
{{ 'namu-marquee.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign duration = section.settings.duration | default: 30
-%}

<section
  class="namu-marquee"
  aria-label="{{ section.settings.aria_label | default: 'Diferenciais Namu' }}"
  style="--namu-marquee-bg: {{ section.settings.bg_color }}; --namu-marquee-text: {{ section.settings.text_color }};"
>
  <div class="namu-marquee__track" data-duration="{{ duration }}">
    {%- comment -%} Renderiza dois grupos para loop infinito sem corte {%- endcomment -%}
    {%- for i in (1..2) -%}
      <ul class="namu-marquee__group" aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}">
        {%- for block in section.blocks -%}
          <li class="namu-marquee__item" {{ block.shopify_attributes }}>
            <span class="namu-marquee__text">{{ block.settings.text | escape }}</span>
          </li>
          <li class="namu-marquee__sep" aria-hidden="true">|</li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    function initMarquee(section) {
      var track = section.querySelector('.namu-marquee__track');
      if (!track || track._namuInit) return;

      // Aguarda layout calculado (garante getBoundingClientRect correto)
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          startAnimation(section, track);
        });
      });
    }

    function startAnimation(section, track) {
      if (track._namuInit) return;
      track._namuInit = true;

      // Mantém apenas 1 grupo no DOM (remove o duplicado do Liquid)
      var groups = track.querySelectorAll('.namu-marquee__group');
      for (var i = 1; i < groups.length; i++) groups[i].remove();

      var group = track.querySelector('.namu-marquee__group');
      if (!group) return;

      // Clona até preencher pelo menos 3x a largura da tela — garante loop sem gap
      while (track.getBoundingClientRect().width < window.innerWidth * 3) {
        var clone = group.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      }

      // Remove animação CSS — JS assume controle total
      track.style.animation = 'none';
      track.style.willChange = 'transform';

      var groupWidth = group.getBoundingClientRect().width;
      var pxPerSec = 80; // velocidade: 80px/s (~agradável para leitura)
      var pos = 0;
      var lastTs = null;
      var paused = false;
      var raf;

      section.addEventListener('mouseenter', function () { paused = true; });
      section.addEventListener('mouseleave', function () { paused = false; });

      function step(ts) {
        if (lastTs === null) lastTs = ts;
        var delta = ts - lastTs;
        lastTs = ts;

        if (!paused && groupWidth > 0) {
          pos -= (pxPerSec / 1000) * delta;
          // Reseta ao completar 1 grupo — loop seamless invisível
          if (pos <= -groupWidth) pos += groupWidth;
          track.style.transform = 'translateX(' + pos + 'px)';
        }
        raf = requestAnimationFrame(step);
      }

      raf = requestAnimationFrame(step);

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.target.contains(section)) cancelAnimationFrame(raf);
      });
    }

    // Inicia após layout completo
    function run() {
      document.querySelectorAll('.namu-marquee').forEach(initMarquee);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }

    document.addEventListener('shopify:section:load', function (e) {
      e.target.querySelectorAll('.namu-marquee').forEach(initMarquee);
    });
  })();
</script>

{% schema %}
{
  "name": "Marquee Namu",
  "tag": "section",
  "class": "shopify-section-namu-marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo",
      "default": "#045133"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Duração de uma volta (segundos)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 50
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Rótulo de acessibilidade",
      "default": "Diferenciais Namu"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "✓ Diferencial"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Marquee Namu",
      "blocks": [
        { "type": "item", "settings": { "text": "✓ Matcha direto de Hadong" } },
        { "type": "item", "settings": { "text": "✓ Processo 100% rastreável, do campo à sua xícara" } },
        { "type": "item", "settings": { "text": "✓ Sabor único e frescor garantido" } },
        { "type": "item", "settings": { "text": "+5.000 clientes satisfeitos" } },
        { "type": "item", "settings": { "text": "✓ Sabor puro e intenso, 100% orgânico" } },
        { "type": "item", "settings": { "text": "✓ Energia limpa + foco sem ansiedade" } },
        { "type": "item", "settings": { "text": "✓ Aprovado por baristas e nutricionistas" } }
      ]
    }
  ]
}
{% endschema %}
