{% render 'css-defer', file: 'namu-benefits.css' %}

<section class="namu-ben" aria-label="Benefícios Namu Matcha">
  <div class="namu-ben__inner">
    {%- for block in section.blocks -%}
      <div class="namu-ben__item" {{ block.shopify_attributes }}>
        <div class="namu-ben__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'energy' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M24 42 V28"/>
                <path d="M24 28 C24 14 10 10 10 10 S10 24 24 28 Z"/>
                <path d="M24 28 C24 14 38 10 38 10 S38 24 24 28 Z"/>
                <path d="M14 40 a14 14 0 0 1 0-20" stroke-dasharray="3 2"/>
                <path d="M34 40 a14 14 0 0 0 0-20" stroke-dasharray="3 2"/>
                <polyline points="12,36 14,40 18,38" stroke-width="1.2"/>
                <polyline points="36,36 34,40 30,38" stroke-width="1.2"/>
              </svg>
            {%- when 'organic' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8 h16 l4 14 -4 4 h-16 l-4-4 Z"/>
                <line x1="16" y1="8" x2="16" y2="26"/>
                <line x1="32" y1="8" x2="32" y2="26"/>
                <line x1="12" y1="26" x2="36" y2="26"/>
                <path d="M20 30 v6 a4 4 0 0 0 8 0 v-6"/>
                <circle cx="24" cy="24" r="16" stroke-width="1.2"/>
                <line x1="10" y1="10" x2="38" y2="38" stroke-width="1.8"/>
              </svg>
            {%- when 'harvest' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M24 42 C24 42 18 38 18 34 V28 C18 28 20 26 24 26"/>
                <path d="M24 42 C24 42 30 38 30 34 V28 C30 28 28 26 24 26"/>
                <path d="M24 26 V18"/>
                <path d="M24 18 C24 10 16 8 16 8 S16 16 24 18 Z"/>
                <path d="M24 18 C24 10 32 8 32 8 S32 16 24 18 Z"/>
                <path d="M14 42 h20" stroke-width="1.2"/>
              </svg>
            {%- when 'antioxidant' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="24" cy="24" r="5"/>
                <circle cx="14" cy="14" r="3.5"/>
                <circle cx="34" cy="14" r="3.5"/>
                <circle cx="14" cy="34" r="3.5"/>
                <circle cx="34" cy="34" r="3.5"/>
                <line x1="18" y1="18" x2="20" y2="20"/>
                <line x1="30" y1="18" x2="28" y2="20"/>
                <line x1="18" y1="30" x2="20" y2="28"/>
                <line x1="30" y1="30" x2="28" y2="28"/>
                <circle cx="24" cy="8" r="2.5"/>
                <circle cx="24" cy="40" r="2.5"/>
                <line x1="24" y1="10.5" x2="24" y2="19"/>
                <line x1="24" y1="29" x2="24" y2="37.5"/>
              </svg>
            {%- when 'calm' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M28 6 L18 22 h8 L20 38"/>
                <path d="M32 22 h6"/>
                <path d="M34 18 h4"/>
                <path d="M34 26 h4"/>
                <path d="M10 32 h8 v10 h-8 Z"/>
                <line x1="14" y1="36" x2="14" y2="38"/>
                <path d="M10 32 C10 28 14 26 14 26 S18 28 18 32"/>
              </svg>
            {%- when 'cognitive' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 38 v-4 a10 10 0 0 1-6-9 A8.5 8.5 0 0 1 18 17 a8.5 8.5 0 0 1 12 0 A8.5 8.5 0 0 1 36 25 a10 10 0 0 1-6 9 v4"/>
                <line x1="18" y1="34" x2="30" y2="34"/>
                <line x1="18" y1="38" x2="30" y2="38"/>
                <path d="M10 20 a18 18 0 0 1 0 12" stroke-dasharray="3 2"/>
                <path d="M38 20 a18 18 0 0 0 0 12" stroke-dasharray="3 2"/>
                <polyline points="8,28 10,32 14,30" stroke-width="1.2"/>
                <polyline points="40,28 38,32 34,30" stroke-width="1.2"/>
              </svg>
            {%- when 'leaf' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M24 42 V22"/>
                <path d="M24 22 C24 8 8 6 8 6 S8 22 24 22 Z"/>
                <path d="M24 28 C22 26 18 27 16 30" stroke-width="1.1"/>
              </svg>
            {%- when 'star' -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="24,7 29,19 42,19 32,27 36,40 24,32 12,40 16,27 6,19 19,19"/>
              </svg>
            {%- else -%}
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="24" cy="24" r="14"/>
                <line x1="24" y1="17" x2="24" y2="24"/>
                <circle cx="24" cy="29" r="1.2" fill="currentColor" stroke="none"/>
              </svg>
          {%- endcase -%}
        </div>

        <div class="namu-ben__text">
          {%- if block.settings.title != blank -%}
            <p class="namu-ben__title">{{ block.settings.title | escape }}</p>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="namu-ben__desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function() {
    const items = document.querySelectorAll('.namu-ben__item');
    if (!items.length || !('IntersectionObserver' in window)) {
      items.forEach(el => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => entry.target.classList.add('is-visible'), i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    items.forEach(item => observer.observe(item));
  })();
</script>

{% schema %}
{
  "name": "Barra de Benefícios",
  "tag": "section",
  "class": "shopify-section-namu-benefits",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "energy",     "label": "Raio / Energia" },
            { "value": "organic",    "label": "Escudo / Orgânico" },
            { "value": "harvest",    "label": "Folhas / Colheita" },
            { "value": "antioxidant","label": "Brilho / Antioxidante" },
            { "value": "calm",       "label": "Relógio / Calma" },
            { "value": "cognitive",  "label": "Cérebro / Cognitivo" },
            { "value": "leaf",       "label": "Folha simples" },
            { "value": "star",       "label": "Estrela" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Benefício"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descrição (opcional)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Barra de Benefícios",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "energy",      "title": "Fonte limpa e natural de energia" } },
        { "type": "benefit", "settings": { "icon": "organic",     "title": "Livre de agrotóxicos e aditivos" } },
        { "type": "benefit", "settings": { "icon": "harvest",     "title": "Matcha fresco, colhido artesanalmente" } },
        { "type": "benefit", "settings": { "icon": "antioxidant", "title": "Rico em antioxidantes e vitaminas" } },
        { "type": "benefit", "settings": { "icon": "calm",        "title": "4 a 6 horas de energia calma" } },
        { "type": "benefit", "settings": { "icon": "cognitive",   "title": "Apoia na função cognitiva" } }
      ]
    }
  ]
}
{% endschema %}
