{% render 'css-defer', file: 'namu-blog-index.css' %}

{%- paginate blog.articles by 12 -%}

<section class="namu-blog-idx" aria-label="Blog Namu">

  <div class="namu-blog-idx__hero">
    {%- if section.settings.hero_image != blank -%}
      <picture class="namu-blog-idx__hero-media">
        {%- if section.settings.hero_image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="
            {{ section.settings.hero_image_mobile | image_url: width: 750 }} 750w,
            {{ section.settings.hero_image_mobile | image_url: width: 1080 }} 1080w" sizes="100vw">
        {%- endif -%}
        <source media="(min-width: 750px)" srcset="
          {{ section.settings.hero_image | image_url: width: 1600 }} 1600w,
          {{ section.settings.hero_image | image_url: width: 2000 }} 2000w,
          {{ section.settings.hero_image | image_url: width: 2560 }} 2560w" sizes="100vw">
        <img
          src="{{ section.settings.hero_image | image_url: width: 2560 }}"
          alt="{{ section.settings.hero_image.alt | default: 'Blog Namu Matcha' | escape }}"
          class="namu-blog-idx__hero-img"
          loading="eager"
          fetchpriority="high"
        >
      </picture>
    {%- endif -%}
    <div class="namu-blog-idx__hero-overlay"></div>
    <div class="namu-blog-idx__hero-inner">
      <span class="namu-blog-idx__eyebrow">Blog</span>
      <h1 class="namu-blog-idx__hero-title">Blog Namu</h1>
      <p class="namu-blog-idx__hero-desc">Descubra a cultura do matcha, receitas exclusivas e rituais de bem-estar para transformar o seu dia a dia.</p>
    </div>
  </div>

  <div class="namu-blog-idx__marquee" aria-hidden="true">
    <div class="namu-blog-idx__marquee-track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'marquee_text' -%}
          <span>✦ {{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'marquee_text' -%}
          <span>✦ {{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'marquee_text' -%}
          <span>✦ {{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'marquee_text' -%}
          <span>✦ {{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if blog.articles.size > 0 -%}
    {%- assign featured = blog.articles.first -%}
    <div class="namu-blog-idx__featured">
      <div class="namu-blog-idx__featured-inner">
        <a href="{{ featured.url }}" class="namu-blog-idx__featured-media">
          {%- if featured.image != blank -%}
            <img
              src="{{ featured.image | image_url: width: 1200 }}"
              srcset="{{ featured.image | image_url: width: 600 }} 600w, {{ featured.image | image_url: width: 900 }} 900w, {{ featured.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 767px) 100vw, 60vw"
              alt="{{ featured.image.alt | default: featured.title | escape }}"
              loading="eager"
              class="namu-blog-idx__featured-img"
            >
          {%- endif -%}
        </a>
        <div class="namu-blog-idx__featured-content">
          {%- if featured.tags.size > 0 -%}
            <span class="namu-blog-idx__tag">{{ featured.tags.first | upcase }}</span>
          {%- endif -%}
          <h2 class="namu-blog-idx__featured-title">
            <a href="{{ featured.url }}">{{ featured.title }}</a>
          </h2>
          <p class="namu-blog-idx__featured-excerpt">{{ featured.excerpt_or_content | strip_html | truncate: 180 }}</p>
          <a href="{{ featured.url }}" class="namu-blog-idx__read-more">
            LER MAIS
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="1" y1="5" x2="13" y2="5"/><polyline points="9 1 13 5 9 9"/></svg>
          </a>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="namu-blog-idx__filters">
    <div class="namu-blog-idx__filters-inner">
      <a href="{{ blog.url }}" class="namu-blog-idx__filter-pill {% if current_tags == blank %}namu-blog-idx__filter-pill--active{% endif %}">Ver todas</a>
      <a href="{{ blog.url }}/tagged/matcha-tradicional" class="namu-blog-idx__filter-pill {% if current_tags contains 'matcha-tradicional' %}namu-blog-idx__filter-pill--active{% endif %}">Matcha Tradicional</a>
      <a href="{{ blog.url }}/tagged/coreia-do-sul" class="namu-blog-idx__filter-pill {% if current_tags contains 'coreia-do-sul' %}namu-blog-idx__filter-pill--active{% endif %}">Coreia do Sul</a>
      <a href="{{ blog.url }}/tagged/hadong" class="namu-blog-idx__filter-pill {% if current_tags contains 'hadong' %}namu-blog-idx__filter-pill--active{% endif %}">Hadong</a>
      <a href="{{ blog.url }}/tagged/armazenamento-chasen" class="namu-blog-idx__filter-pill {% if current_tags contains 'armazenamento-chasen' %}namu-blog-idx__filter-pill--active{% endif %}">Armazenamento Chasen</a>
      <a href="{{ blog.url }}/tagged/dia-das-maes" class="namu-blog-idx__filter-pill {% if current_tags contains 'dia-das-maes' %}namu-blog-idx__filter-pill--active{% endif %}">Dia das Mães</a>
      <a href="{{ blog.url }}/tagged/eventos" class="namu-blog-idx__filter-pill {% if current_tags contains 'eventos' %}namu-blog-idx__filter-pill--active{% endif %}">Eventos</a>
      <a href="{{ blog.url }}/tagged/l-teanina" class="namu-blog-idx__filter-pill {% if current_tags contains 'l-teanina' %}namu-blog-idx__filter-pill--active{% endif %}">L-Teanina</a>
      <a href="{{ blog.url }}/tagged/matcha-meditacao" class="namu-blog-idx__filter-pill {% if current_tags contains 'matcha-meditacao' %}namu-blog-idx__filter-pill--active{% endif %}">Matcha Meditação</a>
      <a href="{{ blog.url }}/tagged/presente" class="namu-blog-idx__filter-pill {% if current_tags contains 'presente' %}namu-blog-idx__filter-pill--active{% endif %}">Presente</a>
    </div>
  </div>

  <div class="namu-blog-idx__grid-section">
    <div class="namu-blog-idx__grid">
      {%- for article in blog.articles -%}
        {%- if forloop.first and current_tags == blank -%}{%- continue -%}{%- endif -%}
        <article class="namu-blog-idx__card">
          <a href="{{ article.url }}" class="namu-blog-idx__card-media">
            {%- if article.image != blank -%}
              <img
                src="{{ article.image | image_url: width: 600 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w"
                sizes="(max-width: 767px) 100vw, 33vw"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                class="namu-blog-idx__card-img"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'namu-blog-idx__card-placeholder' }}
            {%- endif -%}
          </a>
          <div class="namu-blog-idx__card-content">
            {%- if article.tags.size > 0 -%}
              <span class="namu-blog-idx__tag namu-blog-idx__tag--sm">{{ article.tags.first }}</span>
            {%- endif -%}
            <h3 class="namu-blog-idx__card-title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>
            <p class="namu-blog-idx__card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            <a href="{{ article.url }}" class="namu-blog-idx__read-more namu-blog-idx__read-more--sm">
              LER MAIS
              <svg width="12" height="8" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="1" y1="5" x2="13" y2="5"/><polyline points="9 1 13 5 9 9"/></svg>
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
    <div class="namu-blog-idx__loadmore">
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="namu-blog-idx__loadmore-cta">
          VER MAIS ARTIGOS
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="1" y1="5" x2="13" y2="5"/><polyline points="9 1 13 5 9 9"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

</section>

{%- endpaginate -%}

{% schema %}
{
  "name": "Blog Index Namu",
  "tag": "section",
  "class": "shopify-section-namu-blog-index",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagem Hero (desktop)",
      "info": "Tamanho ideal: 2560x1440px (16:9). Peso máximo: 200kb."
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Imagem Hero (mobile)",
      "info": "Tamanho ideal: 1080x1920px (9:16). Peso máximo: 150kb."
    }
  ],
  "blocks": [
    {
      "type": "marquee_text",
      "name": "Texto rotativo",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Benefício"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Index Namu",
      "blocks": [
        { "type": "marquee_text", "settings": { "text": "Cultura do matcha" } },
        { "type": "marquee_text", "settings": { "text": "Rituais de bem-estar" } },
        { "type": "marquee_text", "settings": { "text": "Receitas exclusivas" } },
        { "type": "marquee_text", "settings": { "text": "Saúde e energia" } },
        { "type": "marquee_text", "settings": { "text": "Tradição japonesa" } }
      ]
    }
  ]
}
{% endschema %}
