<style>
.namu-test-imgs {
  padding: 2rem 1rem;
  max-width: 900px;
  margin: 0 auto;
  margin-top: 100px;
}
.namu-test-imgs h1 {
  font-family: var(--namu-font-heading);
  font-size: 1.5rem;
  text-align: center;
  margin-bottom: 2rem;
}
.namu-test-imgs__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}
.namu-test-imgs__item {
  text-align: center;
}
.namu-test-imgs__label {
  font-family: var(--namu-font-body);
  font-size: 0.85rem;
  font-weight: 700;
  background: #1a1a1a;
  color: #fff;
  display: inline-block;
  padding: 0.4rem 1rem;
  border-radius: 4px;
  margin-bottom: 0.75rem;
}
.namu-test-imgs__img-wrap {
  position: relative;
  width: 100%;
  max-width: 390px;
  margin: 0 auto;
  height: 796px;
  overflow: hidden;
  border: 2px solid #ddd;
  border-radius: 8px;
  background: #f0f0f0;
}
.namu-test-imgs__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.namu-test-imgs__info {
  font-family: var(--namu-font-body);
  font-size: 0.75rem;
  color: #666;
  margin-top: 0.5rem;
}
@media (max-width: 700px) {
  .namu-test-imgs__grid {
    grid-template-columns: 1fr;
  }
}
</style>

<div class="namu-test-imgs">
  <h1>Teste de Proporção — Hero Mobile</h1>
  <p style="text-align:center; font-size:0.85rem; color:#666; margin-bottom:2rem;">
    Container simula viewport mobile: 390x796px (iPhone 14, descontando 48px do announcement)
  </p>

  <div class="namu-test-imgs__grid">
    <div class="namu-test-imgs__item">
      <span class="namu-test-imgs__label">IMAGEM 1 — 9:16</span>
      <div class="namu-test-imgs__img-wrap">
        <img src="{{ 'ChatGPT Image May 18, 2026, 05_16_45 PM.png' | asset_url }}" alt="Teste 9:16">
      </div>
      <p class="namu-test-imgs__info">Arquivo: 05_16_45 PM.png</p>
    </div>

    <div class="namu-test-imgs__item">
      <span class="namu-test-imgs__label">IMAGEM 2 — 1:2 (1080x2160)</span>
      <div class="namu-test-imgs__img-wrap">
        <img src="{{ 'ChatGPT Image May 18, 2026, 05_18_22 PM.png' | asset_url }}" alt="Teste 1:2">
      </div>
      <p class="namu-test-imgs__info">Arquivo: 05_18_22 PM.png</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Teste Imagens Mobile",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Teste Imagens Mobile"
    }
  ]
}
{% endschema %}
