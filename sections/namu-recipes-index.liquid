{% render 'css-defer', file: 'namu-recipes-index.css' %}

{%- assign recipe_blog = blogs['receitas-matcha'] -%}
{%- paginate recipe_blog.articles by 12 -%}

<section class="namu-rec-idx" aria-label="Receitas">

  <div class="namu-rec-idx__header">
    <div class="namu-rec-idx__header-inner">
      <h1 class="namu-rec-idx__title">Receitas</h1>
      <p class="namu-rec-idx__subtitle">Explore nossas receitas com matcha e descubra novas formas de incluir esse superalimento no seu dia a dia.</p>
    </div>
  </div>

  <div class="namu-rec-idx__filters" role="navigation" aria-label="Filtros de receitas">
    <div class="namu-rec-idx__filters-inner">
      <a href="{{ recipe_blog.url }}" class="namu-rec-idx__pill {% if current_tags == blank %}namu-rec-idx__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Todas as receitas
      </a>
      <a href="{{ recipe_blog.url }}/tagged/destaques" class="namu-rec-idx__pill {% if current_tags contains 'destaques' %}namu-rec-idx__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Destaques
      </a>
      <a href="{{ recipe_blog.url }}/tagged/bebidas-quentes" class="namu-rec-idx__pill {% if current_tags contains 'bebidas-quentes' %}namu-rec-idx__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
        Bebidas Quentes
      </a>
      <a href="{{ recipe_blog.url }}/tagged/bebidas-geladas" class="namu-rec-idx__pill {% if current_tags contains 'bebidas-geladas' %}namu-rec-idx__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Bebidas Geladas
      </a>
      <a href="{{ recipe_blog.url }}/tagged/comidinhas" class="namu-rec-idx__pill {% if current_tags contains 'comidinhas' %}namu-rec-idx__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
        Comidinhas
      </a>
    </div>
  </div>

  <div class="namu-rec-idx__grid-section">
    <div class="namu-rec-idx__grid">
      {%- for article in recipe_blog.articles -%}
        <article class="namu-rec-idx__card">
          <a href="{{ article.url }}" class="namu-rec-idx__card-media">
            {%- if article.image != blank -%}
              <img
                src="{{ article.image | image_url: width: 600 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w"
                sizes="(max-width: 767px) 50vw, 33vw"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                class="namu-rec-idx__card-img"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'namu-rec-idx__card-placeholder' }}
            {%- endif -%}
            {%- for tag in article.tags -%}
              {%- if tag contains 'cat-' -%}
                <span class="namu-rec-idx__card-badge">{{ tag | remove: 'cat-' | replace: '-', ' ' | upcase }}</span>
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          </a>
          <h3 class="namu-rec-idx__card-title">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h3>
        </article>
      {%- endfor -%}
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="namu-rec-idx__pagination" aria-label="Paginação">
      {{ paginate | default_pagination }}
    </nav>
  {%- endif -%}

</section>

{%- endpaginate -%}

{% schema %}
{
  "name": "Receitas Index",
  "tag": "section",
  "class": "shopify-section-namu-recipes-index",
  "settings": [],
  "blocks": [],
  "presets": [
    {
      "name": "Receitas Index"
    }
  ]
}
{% endschema %}
