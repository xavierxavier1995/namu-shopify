{% render 'css-defer', file: 'namu-recipes-index.css' %}

{%- assign recipe_blog = blogs['receitas-matcha'] -%}
{%- paginate recipe_blog.articles by 12 -%}

<section class="namu-rec-idx" aria-label="Receitas">

  <div class="namu-rec-idx__header">
    <div class="namu-rec-idx__header-inner">
      <h1 class="namu-rec-idx__title">Guia de Receitas Namu</h1>
      <p class="namu-rec-idx__subtitle">Explore nossas receitas com matcha e descubra novas formas de incluir esse superalimento no seu dia a dia.</p>
    </div>
  </div>

  <div class="namu-rec-idx__marquee" aria-hidden="true">
    <div class="namu-rec-idx__marquee-track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'marquee_text' -%}
          <span>✦ {{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'marquee_text' -%}
          <span>✦ {{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="namu-rec-idx__filters" role="navigation" aria-label="Filtros de receitas">
    <div class="namu-rec-idx__filters-inner">
      <button type="button" class="namu-rec-idx__pill namu-rec-idx__pill--active" data-filter="all">Ver todas</button>
      <button type="button" class="namu-rec-idx__pill" data-filter="destaques">Destaques</button>
      <button type="button" class="namu-rec-idx__pill" data-filter="bebidas-geladas">Bebidas Geladas</button>
      <button type="button" class="namu-rec-idx__pill" data-filter="bebidas-quentes">Bebidas Quentes</button>
      <button type="button" class="namu-rec-idx__pill" data-filter="comidinhas">Comidinhas</button>
    </div>
  </div>

  <div class="namu-rec-idx__grid-section">
    <div class="namu-rec-idx__grid">
      {%- for article in recipe_blog.articles -%}
        {%- assign tag_handles = '' -%}
        {%- for tag in article.tags -%}
          {%- assign tag_handle = tag | handleize -%}
          {%- assign tag_handles = tag_handles | append: tag_handle -%}
          {%- unless forloop.last -%}{%- assign tag_handles = tag_handles | append: ',' -%}{%- endunless -%}
        {%- endfor -%}
        <article class="namu-rec-idx__card" data-tags="{{ tag_handles }}">
          <a href="{{ article.url }}" class="namu-rec-idx__card-media">
            {%- if article.image != blank -%}
              <img
                src="{{ article.image | image_url: width: 600 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w"
                sizes="(max-width: 767px) 50vw, 33vw"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                class="namu-rec-idx__card-img"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'namu-rec-idx__card-placeholder' }}
            {%- endif -%}
            {%- for tag in article.tags -%}
              {%- if tag contains 'cat-' -%}
                <span class="namu-rec-idx__card-badge">{{ tag | remove: 'cat-' | replace: '-', ' ' | upcase }}</span>
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          </a>
          <h3 class="namu-rec-idx__card-title">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h3>
          {%- if article.excerpt != blank -%}
            <p class="namu-rec-idx__card-excerpt">{{ article.excerpt | strip_html | truncate: 80 }}</p>
          {%- endif -%}
          <a href="{{ article.url }}" class="namu-rec-idx__card-link">Ver receita</a>
        </article>
      {%- endfor -%}
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="namu-rec-idx__pagination" aria-label="Paginação">
      {{ paginate | default_pagination }}
    </nav>
  {%- endif -%}

</section>

<script>
(function() {
  var section = document.querySelector('.namu-rec-idx');
  if (!section) return;
  var pills = section.querySelectorAll('[data-filter]');
  var cards = section.querySelectorAll('.namu-rec-idx__card');

  pills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      var filter = this.getAttribute('data-filter');
      pills.forEach(function(p) { p.classList.remove('namu-rec-idx__pill--active'); });
      this.classList.add('namu-rec-idx__pill--active');

      cards.forEach(function(card) {
        if (filter === 'all') {
          card.style.display = '';
        } else {
          var tags = (card.getAttribute('data-tags') || '').split(',');
          card.style.display = tags.indexOf(filter) !== -1 ? '' : 'none';
        }
      });

      var url = new URL(window.location);
      if (filter === 'all') {
        url.searchParams.delete('filtro');
      } else {
        url.searchParams.set('filtro', filter);
      }
      history.replaceState(null, '', url);
    });
  });

  var params = new URLSearchParams(window.location.search);
  var initial = params.get('filtro');
  if (initial) {
    var target = section.querySelector('[data-filter="' + initial + '"]');
    if (target) target.click();
  }
})();
</script>

{%- endpaginate -%}

{% schema %}
{
  "name": "Receitas Index",
  "tag": "section",
  "class": "shopify-section-namu-recipes-index",
  "settings": [],
  "blocks": [
    {
      "type": "marquee_text",
      "name": "Texto rotativo",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Benefício"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Receitas Index",
      "blocks": [
        { "type": "marquee_text", "settings": { "text": "Receitas fáceis e rápidas" } },
        { "type": "marquee_text", "settings": { "text": "Matcha de alta qualidade" } },
        { "type": "marquee_text", "settings": { "text": "Bebidas quentes e geladas" } },
        { "type": "marquee_text", "settings": { "text": "Inspiração para o dia a dia" } },
        { "type": "marquee_text", "settings": { "text": "Superalimento japonês" } }
      ]
    }
  ]
}
{% endschema %}
