{{ 'namu-tokens.css' | asset_url | stylesheet_tag }}
{{ 'namu-recipes-index.css' | asset_url | stylesheet_tag }}

{%- assign recipe_blog = blogs['receitas'] -%}
{%- paginate recipe_blog.articles by 12 -%}

<section class="namu-rec" aria-label="Receitas">

  <div class="namu-rec__header">
    <div class="namu-rec__header-inner">
      <nav class="namu-rec__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Receitas</span>
      </nav>
      <h1 class="namu-rec__title">Receitas</h1>
      <p class="namu-rec__subtitle">Explore nossas receitas com matcha e descubra novas formas de incluir esse superalimento no seu dia a dia.</p>
    </div>
  </div>

  <div class="namu-rec__filters" role="navigation" aria-label="Filtros de receitas">
    <div class="namu-rec__filters-inner">
      <a href="{{ recipe_blog.url }}" class="namu-rec__pill {% if current_tags == blank %}namu-rec__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Veja todas
      </a>
      <a href="{{ recipe_blog.url }}/tagged/cat-basicos" class="namu-rec__pill {% if current_tags contains 'cat-basicos' %}namu-rec__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        Básicos
      </a>
      <a href="{{ recipe_blog.url }}/tagged/cat-drinks-quentes" class="namu-rec__pill {% if current_tags contains 'cat-drinks-quentes' %}namu-rec__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
        Drinks Quentes
      </a>
      <a href="{{ recipe_blog.url }}/tagged/cat-drinks-gelados" class="namu-rec__pill {% if current_tags contains 'cat-drinks-gelados' %}namu-rec__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Drinks Gelados
      </a>
      <a href="{{ recipe_blog.url }}/tagged/cat-sobremesas" class="namu-rec__pill {% if current_tags contains 'cat-sobremesas' %}namu-rec__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12h20"/><path d="M12 2a7 7 0 0 1 7 7v3H5V9a7 7 0 0 1 7-7z"/><path d="M5 15v2a4 4 0 0 0 4 4h6a4 4 0 0 0 4-4v-2"/></svg>
        Sobremesas
      </a>
      <a href="{{ recipe_blog.url }}/tagged/cat-salgados" class="namu-rec__pill {% if current_tags contains 'cat-salgados' %}namu-rec__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        Salgados
      </a>
      <a href="{{ recipe_blog.url }}/tagged/cat-destaques" class="namu-rec__pill {% if current_tags contains 'cat-destaques' %}namu-rec__pill--active{% endif %}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Destaques
      </a>
    </div>
  </div>

  <div class="namu-rec__grid-section">
    <div class="namu-rec__grid">
      {%- for article in recipe_blog.articles -%}
        <article class="namu-rec__card">
          <a href="{{ article.url }}" class="namu-rec__card-media">
            {%- if article.image != blank -%}
              <img
                src="{{ article.image | image_url: width: 600 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w"
                sizes="(max-width: 767px) 50vw, 33vw"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                class="namu-rec__card-img"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'namu-rec__card-placeholder' }}
            {%- endif -%}
            {%- for tag in article.tags -%}
              {%- if tag contains 'cat-' -%}
                <span class="namu-rec__card-badge">{{ tag | remove: 'cat-' | replace: '-', ' ' | upcase }}</span>
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          </a>
          <h3 class="namu-rec__card-title">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h3>
        </article>
      {%- endfor -%}
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="namu-rec__pagination" aria-label="Paginação">
      {{ paginate | default_pagination }}
    </nav>
  {%- endif -%}

</section>

{%- endpaginate -%}

{% schema %}
{
  "name": "Receitas Index",
  "tag": "section",
  "class": "shopify-section-namu-recipes-index",
  "settings": [],
  "blocks": [],
  "presets": [
    {
      "name": "Receitas Index"
    }
  ]
}
{% endschema %}
