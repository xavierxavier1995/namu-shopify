{{ 'namu-tokens.css' | asset_url | stylesheet_tag }}
{{ 'namu-collection-faq.css' | asset_url | stylesheet_tag }}

<section class="namu-faq-coll" aria-label="Perguntas Frequentes">
  <div class="namu-faq-coll__inner">
    <span class="namu-faq-coll__eyebrow">FAQ</span>
    <h2 class="namu-faq-coll__title">{{ section.settings.title | default: 'Perguntas Frequentes' }}</h2>

    <div class="namu-faq-coll__list">
      {%- for block in section.blocks -%}
        <details class="namu-faq-coll__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="namu-faq-coll__question">
            <span>{{ block.settings.question }}</span>
            <span class="namu-faq-coll__icon" aria-hidden="true">
              <svg class="namu-faq-coll__icon-plus" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="9" y1="3" x2="9" y2="15"/><line x1="3" y1="9" x2="15" y2="9"/></svg>
              <svg class="namu-faq-coll__icon-minus" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="3" y1="9" x2="15" y2="9"/></svg>
            </span>
          </summary>
          <div class="namu-faq-coll__answer">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ Coleção",
  "tag": "section",
  "class": "shopify-section-namu-collection-faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Perguntas Frequentes"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Pergunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pergunta"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Resposta"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Coleção",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Qual a diferença entre Matcha Culinário e Cerimonial?",
            "answer": "O Matcha Cerimonial é feito com as folhas mais jovens e delicadas, resultando em um sabor mais suave e doce, ideal para beber puro. O Culinário tem um sabor mais intenso e é perfeito para receitas."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Como armazenar o Matcha corretamente?",
            "answer": "Mantenha o Matcha em local fresco, seco e protegido da luz. Após aberto, guarde na geladeira em recipiente hermético e consuma em até 30 dias para máximo frescor."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "O Matcha Namu é orgânico?",
            "answer": "Sim! Nosso Matcha é 100% orgânico, cultivado em Hadong, Coreia do Sul, sem uso de pesticidas ou fertilizantes químicos. Certificado pelo Hadong Green Tea Institute."
          }
        }
      ]
    }
  ]
}
{% endschema %}
