{%- paginate collection.products by 9 -%}

<section class="namu-coll-grid" aria-label="Produtos">
  <div class="namu-coll-grid__body">

    <aside class="namu-coll-grid__sidebar" aria-label="Filtros">
      <button class="namu-coll-grid__filter-toggle" type="button" aria-expanded="false" aria-controls="namu-coll-filters">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="14" y2="12"/><line x1="4" y1="18" x2="9" y2="18"/></svg>
        Filtrar
      </button>

      <div class="namu-coll-grid__filter-backdrop" aria-hidden="true"></div>

      <form class="namu-coll-grid__filters" id="namu-coll-filters" action="{{ collection.url }}" method="get">
        {%- for filter in collection.filters -%}
          <details class="namu-coll-grid__filter-group" {% if forloop.index <= 3 %}open{% endif %}>
            <summary class="namu-coll-grid__filter-heading">
              {{ filter.label }}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 1 5 5 9 1"/></svg>
            </summary>
            <div class="namu-coll-grid__filter-options">
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  <div class="namu-coll-grid__price-range">
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}" placeholder="Min" class="namu-coll-grid__price-input" aria-label="Preço mínimo">
                    <span class="namu-coll-grid__price-sep">—</span>
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}" placeholder="Max" class="namu-coll-grid__price-input" aria-label="Preço máximo">
                  </div>
                {%- else -%}
                  {%- for value in filter.values -%}
                    <label class="namu-coll-grid__filter-label">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} class="namu-coll-grid__filter-check">
                      <span class="namu-coll-grid__filter-text">{{ value.label }}</span>
                      <span class="namu-coll-grid__filter-count">({{ value.count }})</span>
                    </label>
                  {%- endfor -%}
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
        <button type="submit" class="namu-coll-grid__filter-apply">Aplicar filtros</button>
      </form>
    </aside>

    <main class="namu-coll-grid__main">
      <div class="namu-coll-grid__toolbar">
        <p class="namu-coll-grid__count">{{ collection.products_count }} produtos</p>
        <div class="namu-coll-grid__sort">
          <label for="namu-sort" class="namu-coll-grid__sort-label">Ordenar:</label>
          <select id="namu-sort" class="namu-coll-grid__sort-select" onchange="window.location.href=this.value">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.url }}" {% if collection.sort_by == option.value %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>

      <div class="namu-coll-grid__grid">
        {%- for product in collection.products -%}
          <a href="{{ product.url }}" class="namu-coll-grid__card" aria-label="{{ product.title | escape }}">
            <div class="namu-coll-grid__card-media">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 450 }} 450w, {{ product.featured_image | image_url: width: 600 }} 600w"
                  sizes="(max-width: 992px) 50vw, 33vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  {% if forloop.index <= 6 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  class="namu-coll-grid__card-img"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'namu-coll-grid__card-placeholder' }}
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="namu-coll-grid__badge">Sale</span>
              {%- endif -%}
            </div>
            <div class="namu-coll-grid__card-info">
              <div class="namu-coll-grid__card-stars" aria-label="5 de 5 estrelas">
                <svg viewBox="0 0 24 24" fill="var(--namu-verde-matcha)" aria-hidden="true"><polygon points="12,2 15,9 22,9 16.5,14 18.5,21 12,17 5.5,21 7.5,14 2,9 9,9"/></svg>
                <svg viewBox="0 0 24 24" fill="var(--namu-verde-matcha)" aria-hidden="true"><polygon points="12,2 15,9 22,9 16.5,14 18.5,21 12,17 5.5,21 7.5,14 2,9 9,9"/></svg>
                <svg viewBox="0 0 24 24" fill="var(--namu-verde-matcha)" aria-hidden="true"><polygon points="12,2 15,9 22,9 16.5,14 18.5,21 12,17 5.5,21 7.5,14 2,9 9,9"/></svg>
                <svg viewBox="0 0 24 24" fill="var(--namu-verde-matcha)" aria-hidden="true"><polygon points="12,2 15,9 22,9 16.5,14 18.5,21 12,17 5.5,21 7.5,14 2,9 9,9"/></svg>
                <svg viewBox="0 0 24 24" fill="var(--namu-verde-matcha)" aria-hidden="true"><polygon points="12,2 15,9 22,9 16.5,14 18.5,21 12,17 5.5,21 7.5,14 2,9 9,9"/></svg>
              </div>
              <h3 class="namu-coll-grid__card-title">{{ product.title }}</h3>
              <div class="namu-coll-grid__card-price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="namu-coll-grid__price-compare">{{ product.compare_at_price | money }}</span>
                  <span class="namu-coll-grid__price-sale">{{ product.price | money }}</span>
                {%- elsif product.price_varies -%}
                  <span class="namu-coll-grid__price-current">A partir de {{ product.price_min | money }}</span>
                {%- else -%}
                  <span class="namu-coll-grid__price-current">{{ product.price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if collection.products_count > 9 -%}
        <div class="namu-coll-grid__ver-mais">
          <a href="{{ collection.url }}" class="namu-coll-grid__ver-mais-link">
            Ver mais produtos
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="1" y1="5" x2="13" y2="5"/><polyline points="9 1 13 5 9 9"/></svg>
          </a>
        </div>
      {%- endif -%}
    </main>

  </div>
</section>

{%- endpaginate -%}

<script>
(function(){
  var toggle = document.querySelector('.namu-coll-grid__filter-toggle');
  var filters = document.querySelector('.namu-coll-grid__filters');
  var backdrop = document.querySelector('.namu-coll-grid__filter-backdrop');
  if (!toggle || !filters) return;

  function openFilters() {
    filters.classList.add('is-open');
    backdrop.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeFilters() {
    filters.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle.addEventListener('click', function() {
    var expanded = this.getAttribute('aria-expanded') === 'true';
    expanded ? closeFilters() : openFilters();
  });
  if (backdrop) backdrop.addEventListener('click', closeFilters);
})();
</script>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "shopify-section-namu-collection-grid",
  "settings": [],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
