{% render 'css-defer', file: 'namu-categories.css' %}

<section class="namu-cat" aria-label="{{ section.settings.title | default: 'Categorias' | escape }}">
  {%- if section.settings.title != blank -%}
    <div class="namu-cat__header">
      {%- if section.settings.label != blank -%}
        <p class="namu-cat__label">{{ section.settings.label | upcase | escape }}</p>
      {%- endif -%}
      <h2 class="namu-cat__heading">{{ section.settings.title | upcase | escape }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="namu-cat__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="namu-cat__grid">
    {%- for block in section.blocks -%}
      <div class="namu-cat__item" {{ block.shopify_attributes }}>
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="namu-cat__link"
          aria-label="{{ block.settings.title | escape }}"
        >
          <div class="namu-cat__media">
            {%- if block.settings.image != blank -%}
              {%- assign img = block.settings.image -%}
              <img
                src="{{ img | image_url: width: 800 }}"
                srcset="
                  {{ img | image_url: width: 400 }} 400w,
                  {{ img | image_url: width: 700 }} 700w,
                  {{ img | image_url: width: 1000 }} 1000w"
                sizes="(max-width: 767px) 80vw, (max-width: 1023px) 50vw, 25vw"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                class="namu-cat__img"
                width="{{ img.width }}"
                height="{{ img.height }}"
              >
            {%- elsif block.settings.fallback_asset != blank -%}
              <img
                src="{{ block.settings.fallback_asset | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                decoding="async"
                width="800"
                height="1067"
                class="namu-cat__img"
              >
            {%- else -%}
              <div
                class="namu-cat__placeholder"
                style="background: {{ block.settings.placeholder_color | default: 'var(--namu-verde-matcha)' }};"
              ></div>
            {%- endif -%}
          </div>

          <div
            class="namu-cat__overlay"
            style="--overlay-opacity: {{ block.settings.overlay_opacity | default: 40 | divided_by: 100.0 }};"
          ></div>

          <div class="namu-cat__content"></div>
        </a>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Grade de Categorias",
  "tag": "section",
  "class": "shopify-section-namu-categories",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Rótulo acima do título (opcional)",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título da seção (opcional)",
      "default": "Matcha para todos os gostos"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo (opcional)",
      "default": "Do matcha cerimonial ao delicioso matcha com vanilla natural da Bahia. Encontre o matcha perfeito para você."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem (Shopify CDN)"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Asset local (ex: cat-matchas-puros.jpg)",
          "info": "Usado quando nenhuma imagem CDN está selecionada"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Categoria"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Opacidade do overlay (%)",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 35
        },
        {
          "type": "color",
          "id": "placeholder_color",
          "label": "Cor de placeholder (quando sem imagem)",
          "default": "#045133"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Grade de Categorias",
      "settings": {
        "label": "Explore",
        "title": "Nossas Categorias"
      },
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Matchas Puros",
            "link": "/collections/matcha-cerimonial",
            "overlay_opacity": 35,
            "placeholder_color": "#045133"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Blends",
            "link": "/collections/matcha-vanilla",
            "overlay_opacity": 35,
            "placeholder_color": "#33348E"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Utensílios",
            "link": "/collections/kits",
            "overlay_opacity": 35,
            "placeholder_color": "#10A6BD"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Kits",
            "link": "/collections/kits",
            "overlay_opacity": 35,
            "placeholder_color": "#BE5B28"
          }
        }
      ]
    }
  ]
}
{% endschema %}
