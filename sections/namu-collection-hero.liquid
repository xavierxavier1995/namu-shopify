{% render 'css-defer', file: 'namu-collection.css' %}

{%- liquid
  assign hero_img = section.settings.hero_image | default: collection.image
  assign overlay_opacity = section.settings.overlay_opacity | default: 40 | divided_by: 100.0
-%}

<section class="namu-coll-hero" aria-label="{{ collection.title | escape }}">
  <div class="namu-coll-hero__bg">
    {%- if hero_img != blank -%}
      <picture>
        {%- if section.settings.hero_image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="
            {{ section.settings.hero_image_mobile | image_url: width: 750 }} 750w,
            {{ section.settings.hero_image_mobile | image_url: width: 1080 }} 1080w" sizes="100vw">
        {%- endif -%}
        <source media="(min-width: 750px)" srcset="
          {{ hero_img | image_url: width: 1600 }} 1600w,
          {{ hero_img | image_url: width: 2000 }} 2000w,
          {{ hero_img | image_url: width: 2560 }} 2560w" sizes="100vw">
        <img
          src="{{ hero_img | image_url: width: 2560 }}"
          alt="{{ collection.title | escape }}"
          loading="eager"
          fetchpriority="high"
          class="namu-coll-hero__img"
        >
      </picture>
    {%- endif -%}
    <div class="namu-coll-hero__overlay" style="--overlay-opacity: {{ overlay_opacity }};"></div>
  </div>

  <div class="namu-coll-hero__inner">
    <nav class="namu-coll-hero__breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Início</a></li>
        <li aria-current="page">{{ collection.title }}</li>
      </ol>
    </nav>
    <h1 class="namu-coll-hero__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="namu-coll-hero__desc">{{ collection.description | strip_html | truncate: 200 }}</p>
    {%- endif -%}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": "{{ shop.url }}" },
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ shop.url }}{{ collection.url }}" }
  ]
}
</script>

{% schema %}
{
  "name": "Collection Hero",
  "tag": "section",
  "class": "shopify-section-namu-collection-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagem de fundo desktop (sobrescreve imagem da collection)",
      "info": "Tamanho ideal: 2560x1440px (16:9). Peso máximo: 200kb."
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Imagem de fundo mobile",
      "info": "Tamanho ideal: 1080x1920px (9:16). Peso máximo: 150kb."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidade do overlay (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40
    }
  ]
}
{% endschema %}
