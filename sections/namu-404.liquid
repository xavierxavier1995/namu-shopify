{{ 'namu-404.css' | asset_url | stylesheet_tag }}

<div class="namu-404">
  <div class="namu-404__content">
    <div class="namu-404__illustration" aria-hidden="true">
      <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 110 C60 110 60 65 60 50" />
        <path d="M60 50 C45 45 30 30 35 15 C50 20 55 35 60 50" />
        <path d="M60 50 C75 45 90 30 85 15 C70 20 65 35 60 50" />
        <path d="M60 65 C50 60 38 55 35 42 C48 45 55 55 60 65" />
        <path d="M60 65 C70 60 82 55 85 42 C72 45 65 55 60 65" />
        <path d="M60 80 C52 76 44 70 42 60 C52 63 57 72 60 80" />
        <path d="M60 80 C68 76 76 70 78 60 C68 63 63 72 60 80" />
        <circle cx="38" cy="95" r="2" fill="currentColor" stroke="none" opacity="0.3" />
        <circle cx="72" cy="100" r="1.5" fill="currentColor" stroke="none" opacity="0.2" />
        <circle cx="50" cy="105" r="1" fill="currentColor" stroke="none" opacity="0.25" />
      </svg>
    </div>

    <span class="namu-404__code">404</span>

    <h1 class="namu-404__heading">Até as folhas mais calmas se perdem às vezes.</h1>

    <p class="namu-404__subtext">
      A página que você procura não está mais aqui — mas temos caminhos melhores para você explorar.
    </p>

    <div class="namu-404__actions">
      <a href="{{ routes.root_url }}" class="namu-404__btn namu-404__btn--primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m3 9 9-7 9 7"/>
          <path d="M9 22V12h6v10"/>
        </svg>
        Voltar para a Home
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="namu-404__btn namu-404__btn--secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        Conferir Nossos Produtos
      </a>
    </div>
  </div>

  <div class="namu-404__bg-leaf" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="currentColor" stroke="none">
      <path d="M100 180 C100 180 100 100 100 70 C70 60 30 30 40 5 C65 15 85 45 100 70 C115 45 135 15 160 5 C170 30 130 60 100 70 Z" opacity="0.6"/>
    </svg>
  </div>
</div>

