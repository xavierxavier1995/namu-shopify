{% render 'css-defer', file: 'namu-product.css' %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
  assign product_images = product.images
-%}

<div class="namu-pdp" id="namu-pdp-{{ section.id }}">

  {%- comment -%} ── Breadcrumbs ─────────────────────────────── {%- endcomment -%}
  <nav class="namu-pdp__breadcrumbs" aria-label="Navegação">
    <a href="/">Início</a>
    <span aria-hidden="true">›</span>
    {%- if product.collections.size > 0 -%}
      {%- assign col = product.collections.first -%}
      <a href="{{ col.url }}">{{ col.title }}</a>
      <span aria-hidden="true">›</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  {%- comment -%} ── HERO: Gallery + Buy Block ─────────────────── {%- endcomment -%}
  <div class="namu-pdp__hero">

    {%- comment -%} Gallery {%- endcomment -%}
    <div class="namu-pdp__gallery" id="NamuGallery-{{ section.id }}">

      {%- if product_images.size > 1 -%}
        <div class="namu-pdp__gallery-thumbs" role="list" aria-label="Miniaturas do produto">
          {%- for img in product_images limit: 8 -%}
            <button
              class="namu-pdp__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              role="listitem"
              aria-label="Ver imagem {{ forloop.index }}"
              data-src="{{ img | image_url: width: 900 }}"
              data-srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w"
              data-alt="{{ img.alt | default: product.title | escape }}"
            >
              <img
                src="{{ img | image_url: width: 150 }}"
                alt="{{ img.alt | default: product.title | escape }}"
                loading="lazy"
                decoding="async"
                width="72"
                height="72"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="namu-pdp__gallery-main" id="NamuGalleryMain-{{ section.id }}" role="img" aria-label="{{ product.title | escape }}">
        {%- if product_images.size > 0 -%}
          {%- assign main_img = product_images[0] -%}
          <img
            id="NamuGalleryImg-{{ section.id }}"
            src="{{ main_img | image_url: width: 900 }}"
            srcset="{{ main_img | image_url: width: 600 }} 600w,
                    {{ main_img | image_url: width: 900 }} 900w,
                    {{ main_img | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 900px) 100vw, 50vw"
            alt="{{ main_img.alt | default: product.title | escape }}"
            loading="eager"
            decoding="async"
            width="{{ main_img.width }}"
            height="{{ main_img.height }}"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'namu-pdp__gallery-placeholder' }}
        {%- endif -%}
        <span class="namu-pdp__gallery-zoom-hint" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          Ampliar
        </span>
      </div>
    </div>

    {%- comment -%} Buy Block {%- endcomment -%}
    <div class="namu-pdp__buy">

      {%- comment -%} Badges {%- endcomment -%}
      <div class="namu-pdp__badge-row">
        {%- if on_sale -%}
          {%- assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span class="namu-pdp__badge namu-pdp__badge--sale">{{ discount_pct }}% OFF</span>
        {%- endif -%}
        {%- if section.settings.badge_text != blank -%}
          <span class="namu-pdp__badge namu-pdp__badge--limited">{{ section.settings.badge_text | escape }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Title {%- endcomment -%}
      <h1 class="namu-pdp__title">{{ product.title | escape }}</h1>

      {%- comment -%} Stars (static — replace with app integration if needed) {%- endcomment -%}
      {%- if section.settings.show_stars -%}
        <div class="namu-pdp__stars">
          <div class="namu-pdp__stars-icons" aria-hidden="true">
            {% render 'namu-star-rating', count: 5, size: 14 %}
          </div>
          <span class="namu-pdp__stars-avg">{{ section.settings.review_avg | default: '4.9' }}</span>
          <span class="namu-pdp__stars-count">
            <a href="#namu-pdp-reviews-{{ section.id }}">{{ section.settings.review_count | default: 0 }} avaliações</a>
          </span>
        </div>
      {%- endif -%}

      {%- comment -%} Price {%- endcomment -%}
      <div class="namu-pdp__price-block">
        <div class="namu-pdp__price-row">
          {%- if on_sale -%}
            <span class="namu-pdp__price-compare">{{ current_variant.compare_at_price | money }}</span>
            <span class="namu-pdp__price-sale">{{ current_variant.price | money }}</span>
          {%- elsif product.price_varies -%}
            <span class="namu-pdp__price-regular">A partir de {{ product.price_min | money }}</span>
          {%- else -%}
            <span class="namu-pdp__price-regular">{{ current_variant.price | money }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.show_installments and current_variant.price >= 10000 -%}
          {%- assign installment_value = current_variant.price | divided_by: section.settings.installments_count -%}
          <p class="namu-pdp__price-installments">ou {{ section.settings.installments_count }}x de {{ installment_value | money }} sem juros</p>
        {%- endif -%}
      </div>

      {%- comment -%} Short description {%- endcomment -%}
      {%- if product.description != blank -%}
        <p class="namu-pdp__short-desc">{{ product.description | strip_html | truncate: 200 }}</p>
      {%- endif -%}

      {%- comment -%} Variant picker {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="namu-pdp__variants">
            <p class="namu-pdp__variants-label">{{ option.name | escape }}</p>
            <div class="namu-pdp__variants-options" role="group" aria-label="{{ option.name | escape }}">
              {%- for value in option.values -%}
                {%- assign is_active = false -%}
                {%- if current_variant.options contains value -%}
                  {%- assign is_active = true -%}
                {%- endif -%}
                <button
                  type="button"
                  class="namu-pdp__variant-btn{% if is_active %} is-active{% endif %}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  data-option-value="{{ value | escape }}"
                  aria-pressed="{{ is_active }}"
                >{{ value | escape }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      {%- comment -%} Trust signals (acima do botão comprar) {%- endcomment -%}
      <div class="namu-pdp__trust" aria-label="Diferenciais">
        <div class="namu-pdp__trust-item">
          <span class="namu-pdp__trust-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </span>
          <span class="namu-pdp__trust-title">GARANTIA</span>
          <span class="namu-pdp__trust-label">7 dias para trocar</span>
        </div>
        <div class="namu-pdp__trust-item">
          <span class="namu-pdp__trust-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </span>
          <span class="namu-pdp__trust-title">COMPRA SEGURA</span>
          <span class="namu-pdp__trust-label">Sem burocracia</span>
        </div>
        <div class="namu-pdp__trust-item">
          <span class="namu-pdp__trust-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          </span>
          <span class="namu-pdp__trust-title">ATÉ 6X S/ JUROS</span>
          <span class="namu-pdp__trust-label">Com nota fiscal</span>
        </div>
        <div class="namu-pdp__trust-item">
          <span class="namu-pdp__trust-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <span class="namu-pdp__trust-title">SUPORTE</span>
          <span class="namu-pdp__trust-label">Expertise Real</span>
        </div>
      </div>

      {%- comment -%} Add to cart form {%- endcomment -%}
      {%- form 'product', product, id: 'NamuProductForm', class: 'namu-pdp__form' -%}
        <input type="hidden" name="id" id="NamuVariantId-{{ section.id }}" value="{{ current_variant.id }}">
        <div class="namu-pdp__atc-row">
          <div class="namu-pdp__qty" role="group" aria-label="Quantidade">
            <button type="button" class="namu-pdp__qty-btn" aria-label="Diminuir quantidade" data-qty-minus>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <input type="number" name="quantity" value="1" min="1" class="namu-pdp__qty-input" aria-label="Quantidade" id="NamuQty-{{ section.id }}">
            <button type="button" class="namu-pdp__qty-btn" aria-label="Aumentar quantidade" data-qty-plus>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
          </div>
          <button
            type="submit"
            name="add"
            class="namu-pdp__atc-btn"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              COMPRAR
            {%- else -%}
              INDISPONÍVEL
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      {%- comment -%} Gift alert (brinde — preço > R$199,00) {%- endcomment -%}
      <div class="namu-pdp__gift-alert" id="NamuGiftAlert-{{ section.id }}" {% unless current_variant.price > section.settings.gift_threshold %}style="display:none;"{% endunless %}>
        <span class="namu-pdp__gift-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
        </span>
        <div class="namu-pdp__gift-text">
          <strong>{{ section.settings.gift_title }}</strong>
          <span>{{ section.settings.gift_text }}</span>
        </div>
      </div>

      {%- comment -%} Shipping estimate (today+2 to today+10) — rendered via JS for accurate client dates {%- endcomment -%}
      <div class="namu-pdp__shipping-calc">
        <div class="namu-pdp__shipping-header">
          <span class="namu-pdp__shipping-header-label">FRETE E PRAZO</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div class="namu-pdp__shipping-estimate">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <div>
            <strong class="namu-pdp__shipping-dates"></strong>
            <span>Confirme o prazo final na próxima etapa.</span>
          </div>
        </div>
      </div>
      <script>
        (function(){
          var meses = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
          var hoje = new Date();
          var d1 = new Date(hoje); d1.setDate(d1.getDate() + 2);
          var d2 = new Date(hoje); d2.setDate(d2.getDate() + 10);
          var el = document.querySelector('.namu-pdp__shipping-dates');
          if (el) el.textContent = 'Chegará entre ' + d1.getDate() + ' de ' + meses[d1.getMonth()] + ' e ' + d2.getDate() + ' de ' + meses[d2.getMonth()];
        })();
      </script>

      {%- comment -%} Metafield badges {%- endcomment -%}
      {%- assign badges_meta = product.metafields.custom.badges.value -%}
      {%- if badges_meta != blank -%}
        <div class="namu-pdp__meta-badges">
          {%- for badge in badges_meta limit: 4 -%}
            <span class="namu-pdp__meta-badge">{{ badge }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} ── TUDO SOBRE O PRODUTO ─────────────────────── {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    {%- assign about_blocks = section.blocks | where: 'type', 'about_card' -%}
    {%- if about_blocks.size > 0 -%}
      <section class="namu-pdp__about" aria-labelledby="namu-pdp-about-{{ section.id }}">
        <div class="namu-pdp__about-header">
          <p class="namu-pdp__about-label">{{ section.settings.about_label | default: 'DETALHES' | upcase | escape }}</p>
          <h2 class="namu-pdp__about-title" id="namu-pdp-about-{{ section.id }}">{{ section.settings.about_title | default: 'Tudo sobre o Produto' | escape }}</h2>
        </div>
        <div class="namu-pdp__about-grid">
          {%- for block in about_blocks -%}
            <div class="namu-pdp__about-card" {{ block.shopify_attributes }}>
              <span class="namu-pdp__about-card-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'leaf' -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 19 2c1 2 2 4.5 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {%- when 'shield' -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {%- when 'energy' -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  {%- when 'heart' -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {%- else -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {%- endcase -%}
              </span>
              <h3 class="namu-pdp__about-card-title">{{ block.settings.title | escape }}</h3>
              <p class="namu-pdp__about-card-text">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ── COMPARISON TABLE ──────────────────────────── {%- endcomment -%}
  {%- if section.settings.show_comparison -%}
    <section class="namu-pdp__compare" aria-labelledby="namu-pdp-compare-{{ section.id }}">
      <div class="namu-pdp__compare-inner">
        <div class="namu-pdp__compare-header">
          <h2 class="namu-pdp__compare-title" id="namu-pdp-compare-{{ section.id }}">{{ section.settings.compare_title | default: 'Namu vs. Concorrentes' | escape }}</h2>
        </div>
        <table class="namu-pdp__compare-table" role="table">
          <thead>
            <tr>
              <th scope="col">Critério</th>
              <th scope="col">Namu Matcha</th>
              <th scope="col">Outros</th>
            </tr>
          </thead>
          <tbody>
            {%- assign compare_blocks = section.blocks | where: 'type', 'compare_row' -%}
            {%- for block in compare_blocks -%}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.criteria | escape }}</td>
                <td class="namu-pdp__compare-namu">{{ block.settings.namu_value | escape }}</td>
                <td class="namu-pdp__compare-other">{{ block.settings.other_value | escape }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── REVIEWS / SOCIAL PROOF ───────────────────── {%- endcomment -%}
  {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
  {%- if review_blocks.size > 0 -%}
    <section class="namu-pdp__reviews" id="namu-pdp-reviews-{{ section.id }}" aria-labelledby="namu-pdp-reviews-title-{{ section.id }}">
      <div class="namu-pdp__reviews-header">
        <h2 class="namu-pdp__reviews-title" id="namu-pdp-reviews-title-{{ section.id }}">{{ section.settings.reviews_title | default: 'O que nossos clientes dizem' | escape }}</h2>
        <div class="namu-pdp__reviews-summary">
          <span class="namu-pdp__reviews-avg">{{ section.settings.review_avg | default: '4.9' }}</span>
          <span class="namu-pdp__reviews-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- endfor -%}
          </span>
          <span class="namu-pdp__reviews-total">({{ section.settings.review_count | default: 0 }} avaliações)</span>
        </div>
      </div>
      <div class="namu-pdp__reviews-grid">
        {%- for block in review_blocks -%}
          <div class="namu-pdp__review-card" {{ block.shopify_attributes }}>
            <div class="namu-pdp__review-top">
              <span class="namu-pdp__review-name">{{ block.settings.name | escape }}</span>
              <span class="namu-pdp__review-date">{{ block.settings.date | escape }}</span>
            </div>
            <div class="namu-pdp__review-stars" aria-label="{{ block.settings.stars | default: 5 }} estrelas">
              {%- assign star_count = block.settings.stars | default: 5 -%}
              {%- for i in (1..star_count) -%}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- endfor -%}
            </div>
            <p class="namu-pdp__review-text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── FAQ ──────────────────────────────────────── {%- endcomment -%}
  {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
  {%- if faq_blocks.size > 0 -%}
    <section class="namu-pdp__faq" aria-labelledby="namu-pdp-faq-{{ section.id }}">
      <div class="namu-pdp__faq-header">
        <h2 class="namu-pdp__faq-title" id="namu-pdp-faq-{{ section.id }}">{{ section.settings.faq_title | default: 'Perguntas Frequentes' | escape }}</h2>
      </div>
      <div class="namu-pdp__faq-list">
        {%- for block in faq_blocks -%}
          <details class="namu-pdp__faq-item" {{ block.shopify_attributes }}>
            <summary>
              {{ block.settings.question | escape }}
              <svg class="namu-pdp__faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="namu-pdp__faq-answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── SEÇÃO 1: BENEFÍCIOS DO MATCHA ──────────────── {%- endcomment -%}
  <section class="namu-pdp__benefits">
    <div class="namu-pdp__benefits-inner">
      <div class="namu-pdp__benefits-header">
        <span class="namu-pdp__benefits-label">PUREZA CERTIFICADA</span>
        <h2 class="namu-pdp__benefits-title">O Segredo do Matcha Puro Namu</h2>
      </div>
      <div class="namu-pdp__benefits-grid">
        <div class="namu-pdp__benefits-card">
          <span class="namu-pdp__benefits-icon" aria-hidden="true">
