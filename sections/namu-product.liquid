<script>
(function() {
  var sid = '{{ section.id }}';
  var pdp = document.getElementById('namu-pdp-' + sid);
  if (!pdp) return;

  var mainWrap  = document.getElementById('NamuGalleryMain-' + sid);
  var mainImg   = document.getElementById('NamuGalleryImg-' + sid);
  var thumbs    = pdp.querySelectorAll('.namu-pdp__thumb');
  var qtyInput  = document.getElementById('NamuQty-' + sid);
  var variantId = document.getElementById('NamuVariantId-' + sid);

  // Thumbnail switching
  thumbs.forEach(function(btn) {
    btn.addEventListener('click', function() {
      thumbs.forEach(function(t) { t.classList.remove('is-active'); });
      btn.classList.add('is-active');
      if (mainImg) {
        mainImg.src    = btn.dataset.src;
        mainImg.srcset = btn.dataset.srcset;
        mainImg.alt    = btn.dataset.alt;
      }
      if (mainWrap) mainWrap.classList.remove('is-zoomed');
    });
  });

  // Zoom on click
  if (mainWrap) {
    mainWrap.addEventListener('click', function(e) {
      if (mainWrap.classList.contains('is-zoomed')) {
        mainWrap.classList.remove('is-zoomed');
        if (mainImg) mainImg.style.transformOrigin = '';
      } else {
        var rect = mainWrap.getBoundingClientRect();
        var x = ((e.clientX - rect.left) / rect.width * 100).toFixed(1);
        var y = ((e.clientY - rect.top)  / rect.height * 100).toFixed(1);
        if (mainImg) mainImg.style.transformOrigin = x + '% ' + y + '%';
        mainWrap.classList.add('is-zoomed');
      }
    });
  }

  // Gift alert — shows when variant price > R$199
  var giftAlert = document.getElementById('NamuGiftAlert-' + sid);
  var GIFT_THRESHOLD = {{ section.settings.gift_threshold }};
  var currentVariantPrice = {{ current_variant.price }};
  var currentComparePrice = {{ current_variant.compare_at_price | default: 0 }};

  function updateGiftAlert(price) {
    if (!giftAlert) return;
    giftAlert.style.display = price > GIFT_THRESHOLD ? 'flex' : 'none';
  }

  function updateDisplayedPrice() {
    var qty = parseInt(qtyInput ? qtyInput.value : 1, 10) || 1;
    var total = currentVariantPrice * qty;
    var fmt = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    var priceRow = pdp.querySelector('.namu-pdp__price-row');
    if (!priceRow) return;

    if (currentComparePrice && currentComparePrice > currentVariantPrice) {
      var totalCompare = currentComparePrice * qty;
      priceRow.innerHTML =
        '<span class="namu-pdp__price-compare">' + fmt.format(totalCompare / 100) + '</span>' +
        '<span class="namu-pdp__price-sale">' + fmt.format(total / 100) + '</span>';
    } else {
      priceRow.innerHTML = '<span class="namu-pdp__price-regular">' + fmt.format(total / 100) + '</span>';
    }

    // Update gift alert based on total
    updateGiftAlert(total);
  }

  // Quantity buttons
  var qtyMinus = pdp.querySelector('[data-qty-minus]');
  var qtyPlus  = pdp.querySelector('[data-qty-plus]');
  if (qtyMinus && qtyInput) {
    qtyMinus.addEventListener('click', function() {
      var v = parseInt(qtyInput.value, 10) || 1;
      if (v > 1) qtyInput.value = v - 1;
      updateDisplayedPrice();
    });
  }
  if (qtyPlus && qtyInput) {
    qtyPlus.addEventListener('click', function() {
      var v = parseInt(qtyInput.value, 10) || 1;
      qtyInput.value = v + 1;
      updateDisplayedPrice();
    });
  }
  if (qtyInput) {
    qtyInput.addEventListener('change', updateDisplayedPrice);
  }

  // Variant picker
  var variantBtns = pdp.querySelectorAll('.namu-pdp__variant-btn');
  var productVariants = {{ product.variants | json }};

  variantBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var optIdx = parseInt(btn.dataset.optionIndex, 10);
      variantBtns.forEach(function(b) {
        if (parseInt(b.dataset.optionIndex, 10) === optIdx) {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        }
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');

      var selected = [];
      [0,1,2].forEach(function(i) {
        var a = pdp.querySelector('.namu-pdp__variant-btn.is-active[data-option-index="' + i + '"]');
        if (a) selected[i] = a.dataset.optionValue;
      });

      var matched = productVariants.find(function(v) {
        return v.options.every(function(opt, i) {
          return !selected[i] || selected[i] === opt;
        });
      });

      if (matched) {
        if (variantId) variantId.value = matched.id;
        currentVariantPrice = matched.price;
        currentComparePrice = matched.compare_at_price || 0;

        // Update % OFF badge
        var badgeRow = pdp.querySelector('.namu-pdp__badge-row');
        if (badgeRow) {
          var saleBadge = badgeRow.querySelector('.namu-pdp__badge--sale');
          if (matched.compare_at_price && matched.compare_at_price > matched.price) {
            var pct = Math.round((matched.compare_at_price - matched.price) / matched.compare_at_price * 100);
            if (saleBadge) {
              saleBadge.textContent = pct + '% OFF';
            } else {
              var newBadge = document.createElement('span');
              newBadge.className = 'namu-pdp__badge namu-pdp__badge--sale';
              newBadge.textContent = pct + '% OFF';
              badgeRow.prepend(newBadge);
            }
          } else if (saleBadge) {
            saleBadge.remove();
          }
        }

        // Update price display (price × qty)
        updateDisplayedPrice();

        var atcBtn = pdp.querySelector('.namu-pdp__atc-btn');
        if (atcBtn) atcBtn.disabled = !matched.available;
      }
    });
  });

  // End of PDP script
})();
</script>

