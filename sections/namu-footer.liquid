{{ 'namu-tokens.css' | asset_url | stylesheet_tag }}
{{ 'namu-footer.css' | asset_url | stylesheet_tag }}

<footer class="namu-ft" role="contentinfo" aria-label="Rodapé">

  {%- comment -%} ── Newsletter Strip (Pre-footer) ──────── {%- endcomment -%}
  <div class="namu-ft__newsletter">
    <div class="namu-ft__newsletter-inner">
      <div class="namu-ft__newsletter-brand">
        <div class="namu-ft__newsletter-logo">
          <img
            src="{{ 'namu-logo-horizontal-white.svg' | asset_url }}"
            alt="{{ shop.name | escape }}"
            loading="lazy"
            decoding="async"
            width="140"
            height="40"
            class="namu-ft__logo-img"
          >
          <img
            src="{{ 'flag-south-korea.svg' | asset_url }}"
            alt="Origem: Coreia do Sul"
            loading="lazy"
            decoding="async"
            width="28"
            height="19"
            class="namu-ft__flag-img"
          >
        </div>
        <p class="namu-ft__slogan">Do campo à sua xícara.</p>
      </div>
      <div class="namu-ft__newsletter-content">
        <div class="namu-ft__newsletter-text">
          <h4 class="namu-ft__newsletter-title">Faça parte da nossa comunidade</h4>
          <p class="namu-ft__newsletter-desc">Ganhe um presente na sua primeira compra! Além disso, receba receitas exclusivas, novidades e ofertas direto no seu e-mail.</p>
        </div>
        <form class="namu-ft__newsletter-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="namu-ft__newsletter-fields">
            <input type="text" name="contact[first_name]" placeholder="Seu nome" class="namu-ft__input" aria-label="Seu nome">
            <input type="email" name="contact[email]" placeholder="Seu melhor e-mail" class="namu-ft__input" required aria-label="Seu e-mail">
            <button type="submit" class="namu-ft__newsletter-btn">
              QUERO MEU BENEFÍCIO
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="1" y1="5" x2="13" y2="5"/><polyline points="9 1 13 5 9 9"/>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  {%- comment -%} ── Main Grid (4 colunas) ─────────────── {%- endcomment -%}
  <div class="namu-ft__main">
    <div class="namu-ft__main-inner">

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">
            COMPRAS
            <span class="namu-ft__chevron" aria-hidden="true">
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg>
            </span>
          </summary>
          <nav aria-label="Compras">
            <a href="/collections/all" class="namu-ft__link">Todos os produtos</a>
            <a href="/collections/matcha-cerimonial" class="namu-ft__link">Matcha</a>
            <a href="/collections/hojicha" class="namu-ft__link">Hojicha</a>
            <a href="/collections/kits" class="namu-ft__link">Utensílios para chá</a>
            <a href="/collections/kits" class="namu-ft__link">Kits & Gifts</a>
          </nav>
        </details>
      </div>

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">
            INSTITUCIONAL
            <span class="namu-ft__chevron" aria-hidden="true">
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg>
            </span>
          </summary>
          <nav aria-label="Institucional">
            <a href="/pages/sobre" class="namu-ft__link">Sobre a Namu</a>
            <a href="/blogs/news" class="namu-ft__link">Blog</a>
            <a href="/pages/sobre" class="namu-ft__link">Nossos Campos</a>
            <a href="/blogs/receitas" class="namu-ft__link">Receitas</a>
            <a href="/blogs/news/o-que-e-matcha" class="namu-ft__link">O que é Matcha</a>
            <a href="/blogs/news/guia-preparo-matcha" class="namu-ft__link">Como fazer Matcha</a>
            <a href="/blogs/news/beneficios-do-matcha" class="namu-ft__link">Benefícios</a>
          </nav>
        </details>
      </div>

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">
            PROCURANDO AJUDA?
            <span class="namu-ft__chevron" aria-hidden="true">
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg>
            </span>
          </summary>
          <nav aria-label="Ajuda">
            <a href="/pages/faq" class="namu-ft__link">Perguntas Frequentes</a>
            <a href="/pages/contato" class="namu-ft__link">Fale Conosco</a>
          </nav>
          <p class="namu-ft__sub-heading">PRECISA FALAR COM UM HUMANO?</p>
          <a href="mailto:alo@namumatcha.com.br" class="namu-ft__contact-link">alo@namumatcha.com.br</a>
          <a href="tel:+5511930876268" class="namu-ft__contact-link">+55 11 93087-6268</a>
        </details>
      </div>

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">
            ATENDIMENTO
            <span class="namu-ft__chevron" aria-hidden="true">
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg>
            </span>
          </summary>
          <div class="namu-ft__info">
            <p>Seg a Sex: 08:00 às 17:00</p>
            <p>Sáb: 08:00 às 12:00</p>
            <address class="namu-ft__address">Rua João Elias Saada 134 – Pinheiros/SP</address>
          </div>
          <p class="namu-ft__sub-heading">SIGA A NAMU</p>
          <div class="namu-ft__social">
            <a href="https://instagram.com/namumatcha" class="namu-ft__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://tiktok.com/@namumatcha" class="namu-ft__social-link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </a>
            <a href="https://youtube.com/@namumatcha" class="namu-ft__social-link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22.54 6.42A2.78 2.78 0 0 0 20.6 4.47C18.88 4 12 4 12 4s-6.88 0-8.6.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.53C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58Z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98" stroke="none" fill="currentColor"/></svg>
            </a>
          </div>
        </details>
      </div>

    </div>
  </div>

  {%- comment -%} ── Policies Strip ────────────────────── {%- endcomment -%}
  <div class="namu-ft__policies">
    <div class="namu-ft__policies-inner">
      <a href="/policies/shipping-policy">Envio e Frete</a>
      <a href="/policies/privacy-policy">Privacidade</a>
      <a href="/policies/terms-of-service">Termos de Serviço</a>
      <a href="/policies/refund-policy">Troca e Devoluções</a>
    </div>
  </div>

  {%- comment -%} ── Bottom Bar ────────────────────────── {%- endcomment -%}
  <div class="namu-ft__bottom">
    <div class="namu-ft__bottom-inner">
      <div class="namu-ft__payment">
        <span class="namu-ft__bottom-label">PAGAMENTO SEGURO</span>
        <div class="namu-ft__payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'namu-ft__pay-icon' }}
          {%- endfor -%}
        </div>
      </div>
      <div class="namu-ft__seals">
        <span class="namu-ft__seal">🔒 SSL Seguro</span>
        <span class="namu-ft__seal">✓ Shopify Secure</span>
      </div>
    </div>
    <p class="namu-ft__copyright">
      &copy; {{ 'now' | date: '%Y' }} Namu Matcha | CNPJ: 41.401.743/0001-50 | Rua João Elias Saada 134 – Pinheiros/SP
    </p>
  </div>

</footer>

