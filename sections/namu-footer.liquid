{% render 'css-defer', file: 'namu-footer.css' %}

<footer class="namu-ft" role="contentinfo" aria-label="Rodapé">

  <div class="namu-ft__newsletter">
    <div class="namu-ft__newsletter-inner">
      <div class="namu-ft__newsletter-brand">
        <div class="namu-ft__newsletter-logo">
          <img src="{{ 'namu-logo-horizontal-white.svg' | asset_url }}" alt="{{ shop.name | escape }}" loading="lazy" decoding="async" width="140" height="40" class="namu-ft__logo-img">
          <img src="{{ 'flag-south-korea.svg' | asset_url }}" alt="Origem: Coreia do Sul" loading="lazy" decoding="async" width="28" height="19" class="namu-ft__flag-img">
        </div>
        <p class="namu-ft__slogan">Do campo à sua xícara.</p>
      </div>
      <div class="namu-ft__newsletter-content">
        <div class="namu-ft__newsletter-text">
          <h4 class="namu-ft__newsletter-title">Faça parte da nossa comunidade</h4>
          <p class="namu-ft__newsletter-desc">Ganhe um presente na sua primeira compra! Além disso, receba receitas exclusivas, novidades e <strong>ofertas exclusivas direto no seu e-mail</strong>.</p>
        </div>
        {% form 'customer', class: 'namu-ft__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="namu-ft__newsletter-fields">
            <input type="text" name="contact[first_name]" placeholder="Seu nome" class="namu-ft__input" aria-label="Seu nome">
            <input type="email" name="contact[email]" placeholder="Seu melhor e-mail" class="namu-ft__input" required aria-label="Seu e-mail">
            <button type="submit" class="namu-ft__newsletter-btn">
              QUERO MEU BENEFÍCIO
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="1" y1="5" x2="13" y2="5"/><polyline points="9 1 13 5 9 9"/></svg>
            </button>
          </div>
        {% endform %}
      </div>
    </div>
  </div>

  <div class="namu-ft__main">
    <div class="namu-ft__main-inner">

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">Compras<span class="namu-ft__chevron" aria-hidden="true"><svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg></span></summary>
          <nav aria-label="Compras">
            <a href="/collections/all" class="namu-ft__link">Todos os produtos</a>
            <a href="/collections/matcha-cerimonial" class="namu-ft__link">Matchas</a>
            <a href="/collections/utensilios" class="namu-ft__link">Utensílios para chá</a>
            <a href="/collections/colaboracoes" class="namu-ft__link">Colaborações</a>
            <a href="/collections/kits" class="namu-ft__link">Kits & Gifts</a>
            <a href="/collections/vestuario" class="namu-ft__link">Vestuário</a>
          </nav>
        </details>
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">Atacado<span class="namu-ft__chevron" aria-hidden="true"><svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg></span></summary>
          <nav aria-label="Atacado">
            <a href="/pages/b2b" class="namu-ft__link">Para Seu Negócio</a>
            <a href="/pages/atacado" class="namu-ft__link">Atacado</a>
          </nav>
        </details>
      </div>

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">Institucional<span class="namu-ft__chevron" aria-hidden="true"><svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg></span></summary>
          <nav aria-label="Institucional">
            <a href="/pages/sobre" class="namu-ft__link">Sobre</a>
            <a href="/blogs/noticias" class="namu-ft__link">Blog</a>
            <a href="/pages/nossos-campos" class="namu-ft__link">Nossos campos</a>
            <a href="/blogs/receitas" class="namu-ft__link">Receitas</a>
            <a href="/blogs/noticias/o-que-e-matcha" class="namu-ft__link">O que é Matcha</a>
            <a href="/blogs/noticias/guia-preparo-matcha" class="namu-ft__link">Como fazer Matcha</a>
            <a href="/blogs/noticias/beneficios-do-matcha" class="namu-ft__link">Benefícios do Matcha</a>
          </nav>
        </details>
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">Nossas Redes<span class="namu-ft__chevron" aria-hidden="true"><svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg></span></summary>
          <div class="namu-ft__social">
            <a href="https://instagram.com/namumatcha" class="namu-ft__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/></svg></a>
            <a href="https://facebook.com/namumatcha" class="namu-ft__social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
            <a href="https://tiktok.com/@namumatcha" class="namu-ft__social-link" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg></a>
            <a href="https://youtube.com/@namumatcha" class="namu-ft__social-link" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22.54 6.42A2.78 2.78 0 0 0 20.6 4.47C18.88 4 12 4 12 4s-6.88 0-8.6.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.53C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58Z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98" stroke="none" fill="currentColor"/></svg></a>
          </div>
        </details>
      </div>

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">Precisando de ajuda?<span class="namu-ft__chevron" aria-hidden="true"><svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg></span></summary>
          <nav aria-label="Ajuda">
            <a href="/pages/faq" class="namu-ft__link">Perguntas Frequentes (FAQ)</a>
            <a href="/pages/contato" class="namu-ft__link">Fale Conosco</a>
          </nav>
          <p class="namu-ft__sub-heading"><strong>Precisa falar com um humano?</strong></p>
          <a href="mailto:alo@namumatcha.com.br" class="namu-ft__contact-link">alo@namumatcha.com.br</a>
          <a href="tel:+5511930876268" class="namu-ft__contact-link">+55 11 93087-6268</a>
        </details>
      </div>

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">Minha Conta<span class="namu-ft__chevron" aria-hidden="true"><svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg></span></summary>
          <nav aria-label="Minha Conta">
            <a href="/account/login" class="namu-ft__link">Entrar ou Cadastrar</a>
            <a href="/account" class="namu-ft__link">Meus pedidos</a>
            <a href="#namu-nl-form" class="namu-ft__link">Cadastrar na Newsletter</a>
          </nav>
        </details>
      </div>

      <div class="namu-ft__col">
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">Atendimento<span class="namu-ft__chevron" aria-hidden="true"><svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg></span></summary>
          <div class="namu-ft__info">
            <p><strong>Horário de atendimento</strong></p>
            <p>08:00 às 17:00</p>
            <p>Segunda a sexta</p>
            <p>08:00 às 12:00 - Sábado</p>
            <p class="namu-ft__info-note">Horário de Brasília (Exceto domingo e feriados)</p>
          </div>
        </details>
        <details class="namu-ft__accordion" open>
          <summary class="namu-ft__col-heading">Endereço<span class="namu-ft__chevron" aria-hidden="true"><svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 5 5 9 1"/></svg></span></summary>
          <address class="namu-ft__address">
            <p>Rua João Elias Saada 134 – Pinheiros/SP</p>
            <p>CEP: 05427-050</p>
          </address>
        </details>
      </div>

    </div>
  </div>

  <div class="namu-ft__policies">
    <div class="namu-ft__policies-inner">
      <a href="/pages/politica-de-frete">Política de Frete</a>
      <a href="/pages/politica-de-privacidade">Privacidade</a>
      <a href="/pages/termos-de-servico">Termos de Serviço</a>
      <a href="/pages/politica-de-trocas">Trocas e Devoluções</a>
    </div>
  </div>

  <div class="namu-ft__bottom">
    <div class="namu-ft__bottom-inner">
      <div class="namu-ft__security-badges">
        <span class="namu-ft__badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Compra Segura
        </span>
        <span class="namu-ft__badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          SSL Encrypted
        </span>
        <span class="namu-ft__badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Shopify Secure
        </span>
      </div>
      <p class="namu-ft__copyright">
        &copy; {{ 'now' | date: '%Y' }} Namu Matcha | CNPJ: 41.401.743/0001-50 | Rua João Elias Saada 134 – Pinheiros/SP
      </p>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer Namu",
  "tag": "section",
  "class": "shopify-section-namu-footer",
  "settings": [],
